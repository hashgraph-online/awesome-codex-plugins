{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "metis-check": {
      "type": "streamable-http",
      "url": "https://check-api.metisfoundry.com/mcp/check",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["mcp:call"],
            "resource": "https://check-api.metisfoundry.com/mcp/check"
          }
        }
      }
    }
  }
}
