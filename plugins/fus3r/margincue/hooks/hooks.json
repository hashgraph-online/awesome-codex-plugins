{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/margincue.mjs\" hook start", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/margincue.mjs\" hook prompt", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/margincue.mjs\" hook stop", "timeout": 5 }
        ]
      }
    ]
  }
}
