{
  "name": "claude-bulkhead",
  "version": "0.4.0",
  "description": "Claude Code hooks for a machine shared by many sessions and subagents",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "subagents",
    "parallel",
    "guard",
    "processes",
    "ports",
    "memory",
    "worktrees",
    "cli",
    "opencode",
    ".codex-plugin",
    "codex",
    "opencode-plugin",
    "copilot-cli",
    "cursor"
  ],
  "license": "MIT",
  "author": "Myeongseok Kang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dooly6276/claude-bulkhead.git"
  },
  "homepage": "https://github.com/dooly6276/claude-bulkhead#readme",
  "bugs": {
    "url": "https://github.com/dooly6276/claude-bulkhead/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "opencode/plugin.mjs",
  "exports": {
    ".": "./opencode/plugin.mjs",
    "./server": "./opencode/plugin.mjs",
    "./opencode": "./opencode/plugin.mjs",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "bin": {
    "claude-bulkhead": "bin/bulkhead",
    "bulkhead": "bin/bulkhead",
    "bulkhead-slot": "bin/bulkhead-slot",
    "bulkhead-statusline": "bin/bulkhead-statusline"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "test:corpus": "node --test test/corpus.test.js",
    "test:fuzz": "node --test test/fuzz.test.js",
    "coverage": "node --test --experimental-test-coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "16.5.0"
  },
  "files": [
    "bin",
    "src",
    "hooks",
    "opencode",
    ".codex-plugin",
    "codex",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
