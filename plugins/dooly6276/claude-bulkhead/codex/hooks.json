{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/bulkhead\" hook --agent codex",
            "timeout": 30,
            "statusMessage": "bulkhead guards"
          }
        ]
      }
    ]
  }
}
