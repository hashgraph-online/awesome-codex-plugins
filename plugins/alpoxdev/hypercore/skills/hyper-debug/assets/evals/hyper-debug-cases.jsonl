{"id": "hyper-debug-positive-stacktrace-ko", "category": "positive", "language": "ko", "intent": "스택 트레이스 원인 진단", "prompt": "TypeError: Cannot read properties of undefined (reading 'id') at checkout.ts:88 — 이거 왜 나는 거야? 원인만 알려줘.", "expect": "trigger", "runs": 3, "threshold": 0.5, "context": {"files": ["rules/working-loop.md", "rules/hypotheses-and-escalation.md", "rules/fix-and-proof.md"], "sources": []}, "expected_mode": "findings-only", "expected": {"must": ["checkout.ts:88의 실제 값과 호출 경로를 런타임 증거로 확인한다", "최소 두 개의 경쟁 가설과 각각의 구분 관찰을 적는다", "원인만 요청이므로 소스를 편집하지 않는다", "일지를 `.hyper/debug/`에 남기고 `Result: confirmed`로 끝낸다"], "mustNot": ["스택 프레임만 보고 원인을 확정한다", "요청 없이 코드를 고친다"]}, "metrics": ["triggerability", "mode accuracy", "evidence quality"], "note": null}
{"id": "hyper-debug-positive-flaky-ci-en", "category": "positive", "language": "en", "intent": "CI-only intermittent test failure", "prompt": "This test fails in CI maybe one run in five and never locally. Find the cause and fix it.", "expect": "trigger", "runs": 3, "threshold": 0.5, "context": {"files": ["rules/flaky-triage.md", "rules/fix-and-proof.md"], "sources": []}, "expected_mode": "minimal-fix", "expected": {"must": ["분류 표로 경합인지 순서 의존인지 실제 경쟁인지 먼저 가른다", "재시도 래퍼나 더 긴 대기를 쓰지 않는다", "수정 전 red 실행과 수정 후 green 실행을 기록한다", "계측을 모두 제거하고 `Result: fixed`로 끝낸다"], "mustNot": ["flake를 격리하거나 테스트를 지운다", "sleep을 늘려 빈도를 낮춘다"]}, "metrics": ["triggerability", "mode accuracy", "evidence quality"], "note": null}
