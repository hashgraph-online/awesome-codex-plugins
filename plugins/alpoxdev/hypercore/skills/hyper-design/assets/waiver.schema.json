{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hyper-design waivers",
  "type": "object",
  "required": ["version", "waivers"],
  "properties": {
    "version": { "const": 1 },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "reason", "source"],
        "properties": {
          "ruleId": { "type": "string" },
          "value": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "source": { "enum": ["user-confirmed", "documented-brand", "fixture", "generated-output"] },
          "reviewAfter": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
