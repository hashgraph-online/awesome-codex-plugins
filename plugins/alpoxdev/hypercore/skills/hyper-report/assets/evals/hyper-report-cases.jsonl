{"id":"hyper-report-workflow-overflow","category":"workflow","language":"en","intent":"Layout check failure repaired in the source","prompt":"The report renders but page 2 is cut off at the bottom.","expect":"trigger","runs":3,"threshold":0.5,"context":{"files":["references/layout-rules.md","rules/checks.md"],"sources":[]},"expected":{"must":["reads the layout record and names the overflowing page","splits the overflowing block in the source","re-renders"],"mustNot":["shrinks the body type to force a fit"]},"expected_mode":"report","metrics":["triggerability","check discipline"]}
