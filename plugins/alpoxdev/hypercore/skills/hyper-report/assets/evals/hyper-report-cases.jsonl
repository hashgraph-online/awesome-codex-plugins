{"id":"hyper-report-positive-ko-pdf","category":"positive","language":"ko","intent":"임원 보고용 다장 PDF 보고서 요청","prompt":"3분기 실적 분석을 임원 보고용으로 A4 5장짜리 PDF로 만들어줘.","expect":"trigger","runs":3,"threshold":0.5,"context":{"files":["rules/authoring.md"],"sources":[]},"expected":{"must":["결정과 독자를 먼저 확정한다","Markdown 원본을 쓰고 PDF로 렌더링한다","산출물 경로를 보고한다"],"mustNot":["대화 답변만 하고 끝낸다","슬라이드 덱을 대신 만든다"]},"expected_mode":"report","metrics":["triggerability","report shape"]}
{"id":"hyper-report-positive-en-briefing","category":"positive","language":"en","intent":"Two-page executive briefing in English","prompt":"Write up our migration findings as a two-page briefing my CFO will read.","expect":"trigger","runs":3,"threshold":0.5,"context":{"files":["rules/authoring.md"],"sources":[]},"expected":{"must":["produces a document of the stated length","leads with the conclusion","names the reader in the brief"],"mustNot":["returns chat bullets only","exceeds the page budget and calls it a briefing"]},"expected_mode":"brief","metrics":["triggerability","report shape"]}
