{
  "name": "@allswapio/mcp-server",
  "version": "1.0.2",
  "mcpName": "io.github.allswapio/mcp-server",
  "description": "Read-only Model Context Protocol (MCP) server over stdio with three tools: list AllSwap's public asset catalog, return AllSwap's official channels and company details, and build block-explorer links for transaction hashes.",
  "type": "module",
  "license": "MIT",
  "author": "Haohang Network Technology Co., Limited (AllSwap) <service@allswap.io>",
  "homepage": "https://allswap.io/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allswapio/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/allswapio/mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "allswap",
    "crypto",
    "blockchain",
    "block-explorer",
    "asset-catalog"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "allswap-mcp": "bin/allswap-mcp.mjs"
  },
  "main": "./src/server.mjs",
  "types": "./src/server.d.ts",
  "exports": {
    ".": {
      "types": "./src/server.d.ts",
      "import": "./src/server.mjs",
      "default": "./src/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
