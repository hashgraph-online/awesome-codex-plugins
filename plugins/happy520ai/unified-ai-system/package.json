{
  "name": "unified-ai-system",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/happy520ai/unified-ai-system.git"
  },
  "homepage": "https://happy520ai.github.io/unified-ai-system/",
  "bugs": {
    "url": "https://github.com/happy520ai/unified-ai-system/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "start": "pnpm start:ai-gateway-service",
    "dev": "pnpm start:ai-gateway-service",
    "demo": "node ./tools/terminal-demo.mjs",
    "gateway": "node ./apps/agent-console/src/cli.js",
    "mcp": "node ./packages/mcp-server/src/index.js",
    "sync:prompt-demo": "node tools/sync-prompt-enhancer-browser.mjs",
    "notify:indexnow": "node tools/submit-indexnow.mjs",
    "verify:mcp": "pnpm --filter @unified-ai-system/mcp-server test",
    "smoke:mcp": "node ./tools/mcp-smoke.mjs",
    "start:ai-gateway-service": "pnpm --filter @unified-ai-system/ai-gateway-service start",
    "start:agent-console": "pnpm --filter @unified-ai-system/agent-console start",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "check:public": "node tools/public-repo-check.mjs",
    "check:open-source-hygiene": "pnpm check:public",
    "verify:public-clone": "node tools/verify-public-clone.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@2": "2.1.3",
      "brace-expansion@5": "5.0.8",
      "postcss@8": "8.5.18",
      "vite@8": "8.0.16"
    }
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
