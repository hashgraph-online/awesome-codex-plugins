{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/claim_check_hook.py\" ] && CLAIM_CHECK_ENFORCE_MODE=warn python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/claim_check_hook.py\" || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/auto_orient.py\" ] && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/auto_orient.py\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/pipe_guard_hook.py\" ] && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pipe_guard_hook.py\" || true"
          }
        ]
      }
    ]
  }
}
