{
  "name": "@ouonet/praxis",
  "version": "4.4.0",
  "description": "Token-lean discipline skills for coding agents.",
  "license": "MIT",
  "author": "ouonet",
  "homepage": "https://ouonet.github.io/praxis/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouonet/praxis.git"
  },
  "bugs": {
    "url": "https://github.com/ouonet/praxis/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": ".opencode/plugins/praxis.js",
  "bin": {
    "praxis": "bin/praxis.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "rules/",
    "hooks/",
    "extensions/",
    "assets/",
    ".opencode/plugins/",
    ".opencode/INSTALL.md",
    ".claude-plugin/",
    ".codex-plugin/",
    ".copilot-plugin/",
    ".qoder-plugin/",
    ".grok-plugin/",
    "plugin.json",
    "gemini-extension.json",
    "model-tiers.example.yaml",
    "!**/node_modules",
    "!**/node_modules/**"
  ],
  "keywords": [
    "triage",
    "discipline",
    "skills",
    "agent",
    "coding",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test test/adapters.test.js test/cli.test.js test/invariants.test.js test/session-start.test.js",
    "check": "node --test test/invariants.test.js"
  }
}
