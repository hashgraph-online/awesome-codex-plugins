{
  "name": "devrecap",
  "version": "0.3.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "devrecap",
      "version": "0.3.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {},
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "apps/cli": {
      "name": "@devrecap/cli",
      "version": "0.3.0",
      "dependencies": {
        "@devrecap/activity-engine": "*",
        "@devrecap/collectors": "*",
        "@devrecap/report-engine": "*",
        "@devrecap/shared": "*"
      }
    },
    "apps/server": {
      "name": "@devrecap/server",
      "version": "0.1.0",
      "dependencies": {
        "@devrecap/activity-engine": "*",
        "@devrecap/codex-parser": "*",
        "@devrecap/git-parser": "*",
        "@devrecap/import-core": "*",
        "@devrecap/report-engine": "*",
        "@devrecap/shared": "*"
      }
    },
    "node_modules/@devrecap/activity-engine": {
      "resolved": "packages/activity-engine",
      "link": true
    },
    "node_modules/@devrecap/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@devrecap/codex-parser": {
      "resolved": "packages/codex-parser",
      "link": true
    },
    "node_modules/@devrecap/collectors": {
      "resolved": "packages/collectors",
      "link": true
    },
    "node_modules/@devrecap/git-parser": {
      "resolved": "packages/git-parser",
      "link": true
    },
    "node_modules/@devrecap/import-core": {
      "resolved": "packages/import-core",
      "link": true
    },
    "node_modules/@devrecap/report-engine": {
      "resolved": "packages/report-engine",
      "link": true
    },
    "node_modules/@devrecap/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@devrecap/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/activity-engine": {
      "name": "@devrecap/activity-engine",
      "version": "0.1.0",
      "dependencies": {
        "@devrecap/codex-parser": "*",
        "@devrecap/shared": "*"
      }
    },
    "packages/codex-parser": {
      "name": "@devrecap/codex-parser",
      "version": "0.1.0",
      "dependencies": {
        "@devrecap/shared": "*"
      }
    },
    "packages/collectors": {
      "name": "@devrecap/collectors",
      "version": "0.1.0",
      "dependencies": {
        "@devrecap/codex-parser": "*",
        "@devrecap/git-parser": "*",
        "@devrecap/shared": "*"
      }
    },
    "packages/git-parser": {
      "name": "@devrecap/git-parser",
      "version": "0.1.0",
      "dependencies": {
        "@devrecap/shared": "*"
      }
    },
    "packages/import-core": {
      "name": "@devrecap/import-core",
      "version": "0.1.0",
      "dependencies": {
        "@devrecap/shared": "*"
      }
    },
    "packages/report-engine": {
      "name": "@devrecap/report-engine",
      "version": "0.1.0",
      "dependencies": {
        "@devrecap/activity-engine": "*",
        "@devrecap/shared": "*"
      }
    },
    "packages/shared": {
      "name": "@devrecap/shared",
      "version": "0.1.0"
    }
  }
}
