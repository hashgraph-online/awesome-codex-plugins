{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook.mjs\" codex",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%\\\\src\\\\hook.mjs\" codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook.mjs\" codex",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%\\\\src\\\\hook.mjs\" codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook.mjs\" codex",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%\\\\src\\\\hook.mjs\" codex"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook.mjs\" codex",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%\\\\src\\\\hook.mjs\" codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "spawn_agent|collaborationspawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook.mjs\" codex",
            "timeout": 30,
            "commandWindows": "node \"%PLUGIN_ROOT%\\\\src\\\\hook.mjs\" codex"
          }
        ]
      }
    ]
  }
}