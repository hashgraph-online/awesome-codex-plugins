{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Designer normalized input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "cwd",
    "targets",
    "mode",
    "platform",
    "verification",
    "brandPolicy",
    "browserTargets",
    "maxRepairCycles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "\\S"
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Runtime must establish absolute authorized existing real path."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "mode": {
      "enum": [
        "audit",
        "plan",
        "refine",
        "implement",
        "system"
      ]
    },
    "platform": {
      "enum": [
        "web",
        "native"
      ]
    },
    "verification": {
      "enum": [
        "static",
        "rendered",
        "full"
      ]
    },
    "brandPolicy": {
      "enum": [
        "preserve",
        "authorized-change"
      ],
      "default": "preserve"
    },
    "browserTargets": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "previewUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 4096,
      "description": "Runtime must validate credentials, origin, redirects and network policy."
    },
    "maxRepairCycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 2
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platform": {
            "const": "web"
          }
        }
      },
      "then": {
        "properties": {
          "browserTargets": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
