 "schemas": {
  "TaxonomyVersion": {
   "type": "integer",
   "minimum": 1,
   "description": "Version of the tag taxonomy (facets and their values). A new version can rename or drop values."
  },
  "Generated": {
   "type": "string",
   "description": "Day the catalog's tags were built (YYYY-MM-DD).",
   "format": "date"
  },
  "PackName": {
   "type": "string",
   "description": "Short name of a Telegram emoji pack, as in t.me/addemoji/<name>.",
   "pattern": "^[A-Za-z0-9_]{1,64}$"
  },
  "EmojiId": {
   "type": "string",
   "description": "Telegram custom_emoji_id. Keep it a string: it does not fit a double.",
   "pattern": "^\\d{1,20}$"
  },
  "Format": {
   "type": "string",
   "enum": [
    "static",
    "animated",
    "video"
   ],
   "description": "static: WEBP; animated: TGS (gzip Lottie); video: WEBM."
  },
  "FacetName": {
   "type": "string",
   "enum": [
    "motion",
    "fit",
    "color",
    "palette",
    "style",
    "topic",
    "mood",
    "role",
    "use"
   ],
   "description": "A facet of the taxonomy (GET /api/emoji-facets lists its values)."
  },
  "Confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1,
   "description": "How sure the tag is, 0 to 1."
  },
  "Tag": {
   "type": "array",
   "description": "[value, confidence]",
   "prefixItems": [
    {
     "type": "string",
     "description": "Value id of the facet."
    },
    {
     "$ref": "#/components/schemas/Confidence"
    }
   ],
   "minItems": 2,
   "items": false
  },
  "FacetMap": {
   "type": "object",
   "description": "Tags by facet, most confident first.",
   "propertyNames": {
    "$ref": "#/components/schemas/FacetName"
   },
   "additionalProperties": {
    "type": "array",
    "items": {
     "$ref": "#/components/schemas/Tag"
    }
   }
  },
  "Compatible": {
   "type": "array",
   "description": "Packs drawn alike (style, palette, colours, motion, theme fit), most similar first; similarity 0.75 and up.",
   "items": {
    "type": "array",
    "description": "[pack name, similarity]",
    "prefixItems": [
     {
      "$ref": "#/components/schemas/PackName"
     },
     {
      "$ref": "#/components/schemas/Confidence"
     }
    ],
    "minItems": 2,
    "items": false
   }
  },
  "Look": {
   "type": "object",
   "description": "How the pack is drawn, from a vision pass over its contact sheet.",
   "properties": {
    "line_weight": {
     "type": "string",
     "description": "Stroke weight: bold, hairline, medium, none, thin."
    },
    "fill": {
     "type": "string",
     "description": "Fill: flat, gradient, none, photo, textured."
    },
    "perspective": {
     "type": "string",
     "description": "Perspective: front, mixed, three-quarter."
    },
    "shadows": {
     "type": "string",
     "description": "Shadows: glow, hard, none, soft."
    },
    "characters": {
     "type": "string",
     "description": "Share of emoji with characters (faces, figures): all, none, some."
    },
    "drawn": {
     "type": "string",
     "description": "One line on how the pack is drawn."
    }
   },
   "required": [
    "line_weight",
    "fill",
    "perspective",
    "shadows",
    "characters",
    "drawn"
   ]
  },
  "DescriptionText": {
   "type": "object",
   "properties": {
    "what": {
     "type": "string",
     "description": "What the pack shows."
    },
    "for": {
     "type": "string",
     "description": "What a bot uses it for."
    },
    "not_for": {
     "type": "string",
     "description": "What it does not suit."
    }
   },
   "required": [
    "what",
    "for",
    "not_for"
   ]
  },
  "Description": {
   "type": "object",
   "description": "What the pack is and is for, per language. Optional: present only when the catalog has it.",
   "properties": {
    "en": {
     "$ref": "#/components/schemas/DescriptionText"
    },
    "ru": {
     "$ref": "#/components/schemas/DescriptionText"
    },
    "uk": {
     "$ref": "#/components/schemas/DescriptionText"
    }
   },
   "required": []
  },
  "ErrorCode": {
   "type": "string",
   "enum": [
    "BAD_REQUEST",
    "PACK_NAME",
    "PACK_NOT_FOUND",
    "NO_PREVIEW",
    "NO_ANIMATION",
    "TOO_LARGE",
    "NOT_EMOJI_PACK",
    "RATE_LIMITED",
    "INTERNAL",
    "TELEGRAM_ERROR",
    "TELEGRAM_UNREACHABLE",
    "BUSY",
    "RESOLVER_OFF"
   ],
   "description": "BAD_REQUEST (400): Malformed parameters: an invalid id list, pack name or emoji id, or a query string on a media URL. PACK_NAME (400): A pack name is 1-64 ASCII letters, digits or underscores. PACK_NOT_FOUND (404): Telegram has no pack with this name. NO_PREVIEW (404): This emoji has no picture (or no still thumbnail), or it is not in this pack. NO_ANIMATION (404): This emoji is not an animated (TGS) emoji, or it is not in this pack. TOO_LARGE (413): Telegram's answer or file is larger than the resolver accepts. NOT_EMOJI_PACK (422): The set exists but is a sticker set, not a custom emoji pack. RATE_LIMITED (429): Too many requests from this client, or Telegram asked the resolver to slow down. Wait for Retry-After when present, else a minute. INTERNAL (500): Unexpected server error. TELEGRAM_ERROR (502): Telegram answered with an error. TELEGRAM_UNREACHABLE (502): Telegram did not answer in time. BUSY (503): The resolver's queue is full; retry after Retry-After seconds. RESOLVER_OFF (503): The resolver has no working bot token in this deployment."
  },
  "PackEmoji": {
   "type": "object",
   "properties": {
    "id": {
     "$ref": "#/components/schemas/EmojiId"
    },
    "fallback": {
     "type": "string",
     "description": "The ordinary emoji Telegram shows where custom emoji cannot be drawn; may be empty."
    },
    "format": {
     "$ref": "#/components/schemas/Format"
    },
    "adaptive": {
     "type": "boolean",
     "description": "needs_repainting: Telegram draws it in the text colour, so it fits light and dark themes."
    },
    "preview": {
     "type": [
      "string",
      "null"
     ],
     "description": "Path of the picture (WEBP, the WEBM of a video emoji, the thumbnail of a TGS), relative to the site."
    },
    "animation": {
     "type": [
      "string",
      "null"
     ],
     "description": "Path of the TGS file of an animated emoji, relative to the site."
    },
    "still": {
     "type": [
      "string",
      "null"
     ],
     "description": "Path of a video emoji's still thumbnail, relative to the site."
    },
    "facets": {
     "$ref": "#/components/schemas/FacetMap"
    }
   },
   "required": [
    "id",
    "fallback",
    "format",
    "adaptive",
    "preview",
    "animation",
    "still"
   ]
  },
  "EmojiHit": {
   "type": "object",
   "properties": {
    "pack": {
     "$ref": "#/components/schemas/PackName"
    },
    "id": {
     "$ref": "#/components/schemas/EmojiId"
    },
    "fallback": {
     "type": "string",
     "description": "Ordinary emoji it stands for; may be empty."
    },
    "format": {
     "$ref": "#/components/schemas/Format"
    },
    "adaptive": {
     "type": "boolean"
    },
    "preview": {
     "type": [
      "string",
      "null"
     ],
     "description": "Picture path, relative to the site."
    },
    "animation": {
     "type": [
      "string",
      "null"
     ],
     "description": "TGS path, relative to the site."
    },
    "still": {
     "type": [
      "string",
      "null"
     ],
     "description": "Still thumbnail path, relative to the site."
    },
    "score": {
     "type": "number",
     "description": "Relevance; higher is better."
    },
    "facets": {
     "$ref": "#/components/schemas/FacetMap"
    },
    "pageUrl": {
     "type": "string",
     "description": "Library page of the emoji, relative to the site."
    }
   },
   "required": [
    "pack",
    "id",
    "fallback",
    "format",
    "adaptive",
    "preview",
    "animation",
    "still",
    "score",
    "facets",
    "pageUrl"
   ]
  },
  "SearchResponse": {
   "type": "object",
   "properties": {
    "ok": {
     "const": true
    },
    "taxonomy": {
     "$ref": "#/components/schemas/TaxonomyVersion"
    },
    "generated": {
     "$ref": "#/components/schemas/Generated"
    },
    "query": {
     "type": "string",
     "description": "The words searched, after facet filters were taken out."
    },
    "filters": {
     "type": "array",
     "description": "Facet filters applied, as facet:value-id.",
     "items": {
      "type": "string",
      "description": "facet:value"
     }
    },
    "unknownFilters": {
     "type": "array",
     "description": "facet:value tokens with a known facet but an unknown value; ignored.",
     "items": {
      "type": "string",
      "description": "facet:value"
     }
    },
    "emoji": {
     "type": "array",
     "description": "Best matches first: up to 60, or 200 with a pack filter.",
     "items": {
      "$ref": "#/components/schemas/EmojiHit"
     }
    },
    "packs": {
     "type": "array",
     "description": "Packs with matches, best first.",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "$ref": "#/components/schemas/PackName"
       },
       "score": {
        "type": "number"
       },
       "hits": {
        "type": "integer",
        "minimum": 1,
        "description": "Matching emoji in the pack."
       },
       "facets": {
        "$ref": "#/components/schemas/FacetMap"
       },
       "pageUrl": {
        "type": "string",
        "description": "Library page of the pack, relative to the site."
       }
      },
      "required": [
       "name",
       "score",
       "hits",
       "facets",
       "pageUrl"
      ]
     }
    },
    "suggest": {
     "type": "object",
     "properties": {
      "complete": {
       "type": "array",
       "items": {
        "type": "string",
        "description": "A completed query."
       }
      },
      "related": {
       "type": "array",
       "items": {
        "type": "string",
        "description": "A tag that comes up often in the results."
       }
      },
      "categories": {
       "type": "array",
       "items": {
        "type": "string",
        "description": "A matching library category."
       }
      },
      "didYouMean": {
       "type": [
        "string",
        "null"
