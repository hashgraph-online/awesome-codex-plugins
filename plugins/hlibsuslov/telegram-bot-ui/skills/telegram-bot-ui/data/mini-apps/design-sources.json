  "accent": "--tg-theme-button-color (fills), --tg-theme-accent-text-color (text)",
  "separator": "--tg-theme-section-separator-color, fallback iOS separator_non_opaque",
  "gray_fill": "color-mix(in srgb, var(--tg-theme-text-color) 8%, transparent) (iOS fill_tertiary analogue)",
  "tonal_fill": "color-mix(in srgb, var(--tg-theme-button-color) 12%, transparent)",
  "success_danger": "iOS green/red as light-dark() fallbacks; destructive uses --tg-theme-destructive-text-color"
 },
 "web_materials": {
  "read": "2026-11-24",
  "source": "iOS 27 kit liquid_glass.figma_effect (frost regular 6, medium-large 16) translated to CSS; tint, rim and lift are this skill's approximation [Heuristic]",
  "kit": "examples/mini-apps/_kit/tma.css :root --tma-glass-*",
  "levels": {
   "thin": {
    "use": "icon buttons and chips over photos and video",
    "tint_pct": 45,
    "blur_px": 6
   },
   "regular": {
    "use": "floating tab bar, floating circle, bottom capsules",
    "tint_pct": 62,
    "blur_px": 16,
    "saturate": 1.8
   },
   "thick": {
    "use": "sticky segmented control or search over scrolling text",
    "tint_pct": 80,
    "blur_px": 24
   }
  },
  "never": [
   "cells",
   "cards",
   "sheet content",
   "text blocks",
   "buttons inside content",
   "the page background"
  ],
  "solid_when": [
   "prefers-reduced-transparency",
   "prefers-contrast: more",
   "no backdrop-filter",
   "Android performance class LOW",
   "data-tma-glass=off",
   "dense style"
  ]
 }
