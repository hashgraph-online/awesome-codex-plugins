   "lucide",
   "tabler",
   "phosphor",
   "material-symbols"
  ],
  "lucide": {
   "licence": "ISC",
   "package": "lucide-static (SVG), lucide-react, lucide (vanilla)",
   "site": "https://lucide.dev",
   "style": "24 px grid, stroke 2, round caps: set stroke-width 1.8 to match the kit"
  },
  "tabler": {
   "licence": "MIT",
   "package": "@tabler/icons",
   "site": "https://tabler.io/icons",
   "style": "24 px grid, stroke 2 (outline set)"
  },
  "phosphor": {
   "licence": "MIT",
   "package": "@phosphor-icons/web, @phosphor-icons/react",
   "site": "https://phosphoricons.com",
   "style": "regular weight on 24 px; use one weight"
  },
  "material-symbols": {
   "licence": "Apache-2.0",
   "package": "material-symbols / @material-symbols/svg-400",
   "site": "https://fonts.google.com/icons",
   "style": "Outlined, weight 300-400, for Android-first apps"
  },
  "never": [
   "Unicode emoji as icons or status",
   "SF Symbols artwork (Apple licence: names only, for mapping)",
   "mixing two libraries on one screen",
   "icon fonts loaded from a CDN for a handful of glyphs: inline the SVGs"
  ]
