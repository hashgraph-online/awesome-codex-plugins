{
  "$comment": "Notification and message patterns (references/message-patterns.md). Each example is a slots spec rendered by examples/python/tgkit/notify.py and checked by scripts/message_patterns.py (tests/test_message_patterns.py). sound: ping | silent | ping_if_action | ping_on_open. buttons: required | optional | none.",
  "version": 1,
  "grammar": {
    "header_words": [2, 5],
    "first_line_max": 80,
    "body_lines_max": 8,
    "emoji_per_line_max": 1,
    "emoji_per_message_max": 3,
    "fact_separator": ": ",
    "bullet": "•",
    "timeline_marks": ["✓", "●", "○"]
  },
  "icons": {
    "status": {"done": "✅", "attention": "⚠️", "failed": "❌", "in_progress": "⏳"},
    "category": {"order": "📦", "payment": "💳", "report": "📊", "reminder": "🔔", "message": "💬", "security": "🔐",
                 "price": "🏷", "receipt": "🧾", "alert_up": "📈", "alert_down": "📉", "reward": "🎁"}
  },
  "patterns": [
    {
      "id": "status-change",
      "names": {"en": "Status change", "ru": "Смена статуса", "uk": "Зміна статусу"},
      "find": {"en": ["shipped", "delivered", "approved", "rejected", "status", "is ready", "order update", "closed"],
               "ru": ["отправлен", "доставлен", "одобрен", "отклонен", "статус", "готов", "закрыт", "передан"],
               "uk": ["надіслано", "доставлено", "схвалено", "відхилено", "статус", "готове", "закрито"]},
      "header": {"form": "object + state", "words": [2, 5], "icon": "category (📦) or ✅ when done is the news"},
      "blocks": ["facts", "timeline"],
      "buttons": "optional",
      "sound": "ping_if_action",
      "lifecycle": "new per meaningful step; a tracker is one card edited in place plus a ping on the steps that matter",
      "grouping": "instant",
      "examples": {
        "en": {"icon": "📦", "title": "Order #1042 shipped", "subject": "DHL Express, to Oslo",
               "blocks": [{"type": "code", "label": "Tracking", "value": "JD014600006281"},
                          {"type": "facts", "items": [["Arrives", "tomorrow by 18:00"]]}],
               "buttons": [[{"text": "Track parcel", "url": "https://example.com/track/JD014600006281"}]]},
        "ru": {"icon": "📦", "title": "Заказ #1042 отправлен", "subject": "Новая Почта, отделение № 12",
               "blocks": [{"type": "code", "label": "Трек-номер", "value": "20450012345678"},
                          {"type": "facts", "items": [["Доставка", "завтра, до 18:00"]]}],
               "buttons": [[{"text": "Отследить", "url": "https://example.com/track/20450012345678"}]]}
      }
    },
    {
      "id": "action-required",
      "names": {"en": "Action required", "ru": "Нужно действие", "uk": "Потрібна дія"},
      "find": {"en": ["approve", "approval", "confirm", "decide", "waiting for you", "needs your", "review request"],
               "ru": ["подтверд", "одобр", "согласуй", "ждет вашего", "ждёт вашего", "нужно решение", "требуется"],
               "uk": ["підтверд", "схвал", "погодь", "чекає на вас", "потрібне рішення"]},
      "header": {"form": "the ask", "words": [2, 5], "icon": "⚠️"},
      "blocks": ["facts", "sentence"],
      "buttons": "required",
      "sound": "ping",
      "lifecycle": "edit_on_resolve: the outcome line, buttons removed",
      "grouping": "instant",
      "examples": {
        "en": {"icon": "⚠️", "title": "Approval needed", "subject": "Payout to North Ltd",
               "blocks": [{"type": "facts", "items": [["Amount", "€4,800"], ["Invoice", "#381 of 25 Nov", false]]}],
               "footer": "No answer by 18:00 moves the payout to tomorrow.",
               "buttons": [[{"text": "Approve", "callback_data": "v1:payout:381:ok", "style": "success"},
                            {"text": "Decline", "callback_data": "v1:payout:381:no"}]]},
        "ru": {"icon": "⚠️", "title": "Нужно подтверждение", "subject": "Выплата партнёру ООО «Север»",
               "blocks": [{"type": "facts", "items": [["Сумма", "48 000 ₽"], ["Счёт", "№ 381 от 25.11", false]]}],
               "footer": "Без ответа до 18:00 выплата перенесётся на завтра.",
               "buttons": [[{"text": "Подтвердить", "callback_data": "v1:payout:381:ok", "style": "success"},
                            {"text": "Отклонить", "callback_data": "v1:payout:381:no"}]]}
      }
    },
    {
      "id": "alert-threshold",
      "names": {"en": "Threshold alert", "ru": "Порог пересечён", "uk": "Поріг перетнуто"},
      "find": {"en": ["above", "below", "crossed", "threshold", "price alert", "level", "spike", "dropped below"],
               "ru": ["выше", "ниже", "пересек", "порог", "уровень", "упал", "вырос", "курс"],
               "uk": ["вище", "нижче", "перетн", "поріг", "рівень", "впав", "зріс", "курс"]},
      "header": {"form": "value headline", "words": [2, 5], "icon": "📈 / 📉 (or ⚠️ for a health metric)"},
      "blocks": ["facts"],
      "buttons": "optional",
      "sound": "ping",
      "lifecycle": "new per crossing, with a cool-down; acknowledged alerts edited",
      "grouping": "digest when the value crosses again and again",
      "examples": {
        "en": {"icon": "📈", "title": "BTC above $70,000", "subject": "Your level: $70,000",
               "blocks": [{"type": "facts", "items": [["Now", "$70,412 ▲ 2.1% in an hour"]]}],
               "footer": "as of 14:05",
               "buttons": [[{"text": "Change level", "callback_data": "v1:alert:btc:edit"},
                            {"text": "Turn off", "callback_data": "v1:alert:btc:off"}]]},
        "ru": {"icon": "📈", "title": "BTC выше 70 000 $", "subject": "Ваш уровень: 70 000 $",
               "blocks": [{"type": "facts", "items": [["Сейчас", "70 412 $ ▲ 2,1% за час"]]}],
               "footer": "данные на 14:05",
               "buttons": [[{"text": "Изменить уровень", "callback_data": "v1:alert:btc:edit"},
                            {"text": "Выключить", "callback_data": "v1:alert:btc:off"}]]}
      }
    },
    {
      "id": "incident",
      "names": {"en": "Incident", "ru": "Инцидент", "uk": "Інцидент"},
      "find": {"en": ["down", "outage", "unavailable", "failed deploy", "incident", "is not responding", "errors"],
               "ru": ["недоступ", "упал", "сбой", "авария", "инцидент", "не отвечает", "ошибк"],
               "uk": ["недоступ", "збій", "аварія", "інцидент", "не відповідає", "помилк"]},
      "header": {"form": "problem", "words": [2, 5], "icon": "❌ or ⚠️"},
      "blocks": ["facts", "details"],
      "buttons": "optional",
      "sound": "ping_on_open",
      "lifecycle": "follow-ups reply_to_first; the resolution edits the first message",
      "grouping": "instant",
      "examples": {
        "en": {"icon": "❌", "title": "API unavailable", "subject": "eu-west · since 14:02",
               "blocks": [{"type": "facts", "items": [["Affected", "payments and sign-in"], ["Errors", "38% of requests"]]},
                          {"type": "details", "text": "14:02:11 upstream timeout (gateway-3)\n14:02:40 health check failed x3\n14:03:05 failover started"}],
               "buttons": [[{"text": "Open monitoring", "url": "https://example.com/status"}]]},
        "ru": {"icon": "❌", "title": "API недоступен", "subject": "eu-west · с 14:02",
               "blocks": [{"type": "facts", "items": [["Затронуто", "оплаты и вход"], ["Ошибок", "38% запросов"]]},
                          {"type": "details", "text": "14:02:11 таймаут апстрима (gateway-3)\n14:02:40 проверка здоровья не прошла ×3\n14:03:05 начато переключение"}],
               "buttons": [[{"text": "Открыть мониторинг", "url": "https://example.com/status"}]]}
      }
    },
    {
      "id": "report-kpi",
      "names": {"en": "Report / KPI", "ru": "Отчёт / статистика", "uk": "Звіт / статистика"},
      "find": {"en": ["report", "stats", "statistics", "summary", "daily", "weekly", "revenue", "kpi"],
               "ru": ["отчет", "отчёт", "статистик", "итоги", "за день", "за неделю", "выручк", "продаж"],
               "uk": ["звіт", "статистик", "підсумки", "за день", "за тиждень", "виручк", "продаж"]},
      "header": {"form": "period headline", "words": [2, 5], "icon": "📊"},
      "blocks": ["kpi", "bullets"],
      "buttons": "optional",
      "sound": "silent",
      "lifecycle": "new per period",
      "grouping": "instant",
      "examples": {
        "en": {"icon": "📊", "title": "Sales this week", "subject": "Revenue up, refunds normal", "lang": "en",
               "blocks": [{"type": "kpi", "items": [
                 {"label": "Revenue", "value": "€41,200", "current": 41200, "previous": 36800},
                 {"label": "Orders", "value": "318", "current": 318, "previous": 306},
                 {"label": "Average order", "value": "€129.60", "current": 129.6, "previous": 120.3},
                 {"label": "Refunds", "value": "6", "current": 6, "previous": 8}]}],
               "footer": "compared with last week",
               "buttons": [[{"text": "Full report", "callback_data": "v1:report:week"}]]},
        "ru": {"icon": "📊", "title": "Продажи за неделю", "subject": "Выручка выросла, возвраты в норме", "lang": "ru",
               "blocks": [{"type": "kpi", "items": [
                 {"label": "Выручка", "value": "412 000 ₽", "current": 412000, "previous": 368000},
                 {"label": "Заказы", "value": "318", "current": 318, "previous": 306},
                 {"label": "Средний чек", "value": "1 296 ₽", "current": 1296, "previous": 1203},
                 {"label": "Возвраты", "value": "6", "current": 6, "previous": 8}]}],
               "footer": "по сравнению с прошлой неделей",
               "buttons": [[{"text": "Полный отчёт", "callback_data": "v1:report:week"}]]}
      }
    },
    {
      "id": "product-card",
      "names": {"en": "Product card", "ru": "Карточка товара", "uk": "Картка товару"},
      "find": {"en": ["back in stock", "new arrival", "price drop", "price dropped", "sale", "recommend", "product"],
