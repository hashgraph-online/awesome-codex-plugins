{
  "id": "gradient-word-captions",
  "name": "Gradient-fill word captions",
  "use": "The spoken word fills with a two-colour gradient (blue to pink by default) inside a dark rounded box while the other words stay white.",
  "formats": [
    "9:16",
    "1:1"
  ],
  "duration_s": 7,
  "fonts": [
    {
      "family": "Poppins",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Poppins",
      "weights": [
        800
      ]
    },
    {
      "family": "Outfit",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Outfit",
      "weights": [
        800
      ]
    }
  ],
  "presets": [
    {
      "id": "gradient-word-captions.blue-pink-box",
      "label": "Blue to pink on dark box",
      "look": "Active word gradient #5AA9FF→#FF5EDB at 100deg, box #0B0B12 at 82%",
      "params": {
        "font_family": "Poppins",
        "font_weight": 800,
        "font_size_px": 84,
        "box_color": "rgba(11,11,18,0.82)",
        "box_padding_em": [
          0.18,
          0.4
        ],
        "box_radius_em": 0.36,
        "text_color": "#FFFFFF",
        "active_gradient": "linear-gradient(100deg,#5AA9FF 0%,#FF5EDB 100%)",
        "active_fallback_color": "#FF5EDB",
        "lead_frames": 1,
        "words_per_page": [
          2,
          4
        ],
        "max_width_px": 696
      },
      "sources": [
        8,
        15,
        23
      ]
    },
    {
      "id": "gradient-word-captions.sunset",
      "label": "Sunset",
      "look": "Warm gradient for lifestyle and food",
      "params": {
        "active_gradient": "linear-gradient(100deg,#FFB347 0%,#FF5E62 100%)",
        "active_fallback_color": "#FFB347"
      },
      "sources": [
        8
      ]
    },
    {
      "id": "gradient-word-captions.sweep-fill",
      "label": "Sweep fill",
      "look": "Gradient wipes left to right across the word over its duration",
      "params": {
        "active_gradient": "linear-gradient(90deg,#5AA9FF 0%,#FF5EDB 50%,#FFFFFF 50%,#FFFFFF 100%)",
        "background_size": "200% 100%",
        "sweep": {
          "from_position": "100% 0",
          "to_position": "0% 0",
          "duration": "word",
          "ease": "none"
        }
      },
      "sources": [
        20,
        23
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
