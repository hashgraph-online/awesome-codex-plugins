{
  "id": "serif-italic-captions",
  "name": "Serif italic emphasis captions",
  "use": "Large serif text with a soft shadow and no box; the spoken word flips to italic.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Instrument Serif",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Instrument+Serif",
      "weights": [
        400
      ]
    },
    {
      "family": "Playfair Display",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Playfair+Display",
      "weights": [
        400,
        600
      ]
    },
    {
      "family": "Fraunces",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Fraunces",
      "weights": [
        400,
        600
      ]
    }
  ],
  "presets": [
    {
      "id": "serif-italic-captions.instrument-italic",
      "label": "Instrument italic",
      "look": "Instrument Serif 400, spoken word italic, soft shadow",
      "params": {
        "font_family": "Instrument Serif",
        "font_weight": 400,
        "font_size_px_9x16": 96,
        "font_size_pct_h_9x16": 5.0,
        "font_size_px_16x9": 72,
        "font_size_pct_h_16x9": 6.7,
        "text_color": "#FFFFFF",
        "text_shadow": "0 2px 12px rgba(0,0,0,0.55), 0 0 2px rgba(0,0,0,0.6)",
        "active_style": "italic",
        "swap": {
          "method": "stacked-crossfade",
          "frames": 3
        },
        "letter_spacing_em": -0.005,
        "words_per_page": [
          4,
          7
        ],
        "max_lines": 2,
        "lead_frames": 1
      },
      "sources": [
        1,
        6,
        15
      ]
    },
    {
      "id": "serif-italic-captions.playfair-warm",
      "label": "Playfair warm",
      "look": "Playfair Display with warm ivory text for luxury",
      "params": {
        "font_family": "Playfair Display",
        "font_weight": 500,
        "text_color": "#FFF8EC",
        "line_height": 1.1,
        "letter_spacing_em": -0.01
      },
      "sources": [
        46
      ]
    },
    {
      "id": "serif-italic-captions.fraunces-soft",
      "label": "Fraunces soft",
      "look": "Fraunces with SOFT axis for a friendlier editorial voice",
      "params": {
        "font_family": "Fraunces",
        "font_variation_settings": "'opsz' 72, 'SOFT' 50",
        "font_weight": 400,
        "active_weight": 500,
        "active_style": "italic"
      },
      "sources": [
        46
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
