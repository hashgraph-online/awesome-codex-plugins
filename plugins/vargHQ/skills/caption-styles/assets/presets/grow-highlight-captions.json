{
  "id": "grow-highlight-captions",
  "name": "Grow-in highlight box captions",
  "use": "White words inside a dark rounded box; the spoken word turns yellow and grows into place while the box adjusts its width.",
  "formats": [
    "9:16",
    "1:1"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Montserrat",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Montserrat",
      "weights": [
        800,
        900
      ]
    },
    {
      "family": "Poppins",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Poppins",
      "weights": [
        800
      ]
    }
  ],
  "presets": [
    {
      "id": "grow-highlight-captions.yellow-grow",
      "label": "Yellow grow",
      "look": "Dark rounded box, active word yellow, grows 0.9→1",
      "params": {
        "font_family": "Montserrat",
        "font_weight": 900,
        "font_size_px": 86,
        "text_color": "#FFFFFF",
        "box_color": "rgba(10,10,10,0.78)",
        "box_padding_em": [
          0.2,
          0.45
        ],
        "box_radius_em": 0.4,
        "active_color": "#FFD400",
        "grow": {
          "scale": [
            0.9,
            1.0
          ],
          "frames": 4,
          "ease": "power3.out"
        },
        "box_width_tween": {
          "frames": 5,
          "ease": "cubic-bezier(0.2,0,0,1)"
        },
        "lead_frames": 1,
        "words_per_page": [
          2,
          4
        ],
        "max_width_px": 696,
        "block_center_y_pct_h": 60
      },
      "sources": [
        8,
        15,
        18
      ]
    },
    {
      "id": "grow-highlight-captions.green-grow",
      "label": "Green grow",
      "look": "Money/finance green accent",
      "params": {
        "active_color": "#3DFF8A"
      },
      "sources": [
        8
      ]
    },
    {
      "id": "grow-highlight-captions.reveal-grow",
      "label": "Reveal grow",
      "look": "Words appear only as spoken, box grows to fit",
      "params": {
        "reveal_mode": "progressive",
        "word_in": {
          "opacity_frames": 2,
          "scale": [
            0.9,
            1.0
          ],
          "scale_frames": 4,
          "ease": "power3.out"
        }
      },
      "sources": [
        18
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
