{
  "id": "active-word-color-captions",
  "name": "Active word colour captions",
  "use": "White outlined text, a few words at a time, where only the colour of the spoken word changes: no scale, no box.",
  "formats": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "duration_s": 7,
  "fonts": [
    {
      "family": "Montserrat",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Montserrat",
      "weights": [
        800
      ]
    },
    {
      "family": "Poppins",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Poppins",
      "weights": [
        700,
        800
      ]
    },
    {
      "family": "Inter",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter",
      "weights": [
        800
      ]
    }
  ],
  "presets": [
    {
      "id": "active-word-color-captions.blue-outline",
      "label": "Blue outline",
      "look": "Montserrat 800 white with black stroke, spoken word #4DA3FF",
      "params": {
        "font_family": "Montserrat",
        "font_weight": 800,
        "font_size_px": 84,
        "text_color": "#FFFFFF",
        "stroke_px": 9,
        "stroke_color": "#000000",
        "paint_order": "stroke fill",
        "active_color": "#4DA3FF",
        "lead_frames": 1,
        "words_per_page": [
          3,
          5
        ],
        "page_combine_ms": 1200,
        "break_on_silence_ms": 400,
        "max_lines": 2,
        "max_width_px": 696
      },
      "sources": [
        8,
        15,
        16,
        24
      ]
    },
    {
      "id": "active-word-color-captions.yellow-outline",
      "label": "Yellow outline",
      "look": "Classic yellow active word for maximum legibility",
      "params": {
        "active_color": "#FFE600",
        "text_shadow": "0 3px 0 rgba(0,0,0,0.55)"
      },
      "sources": [
        4,
        8
      ]
    },
    {
      "id": "active-word-color-captions.calm-phrase",
      "label": "Calm phrase (accessible)",
      "look": "No highlight: same page grouping, all white",
      "params": {
        "active_color": "#FFFFFF",
        "words_per_page": [
          5,
          8
        ],
        "max_lines": 2
      },
      "sources": [
        28,
        31
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
