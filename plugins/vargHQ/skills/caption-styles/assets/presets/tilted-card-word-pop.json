{
  "id": "tilted-card-word-pop",
  "name": "Tilted card word pops",
  "use": "One uppercase word at a time springs in on a slightly rotated sticker-like card, alternating white and lime.",
  "formats": [
    "9:16",
    "1:1"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Anton",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Anton",
      "weights": [
        400
      ]
    },
    {
      "family": "Archivo Black",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Archivo+Black",
      "weights": [
        400
      ]
    },
    {
      "family": "Bebas Neue",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Bebas+Neue",
      "weights": [
        400
      ]
    }
  ],
  "presets": [
    {
      "id": "tilted-card-word-pop.white-lime-alt",
      "label": "White / lime alternating",
      "look": "Anton caps on cards tilted -4° / +3°, colours alternate every word",
      "params": {
        "font_family": "Anton",
        "text_transform": "uppercase",
        "font_size_px": 140,
        "font_size_pct_h": 7.3,
        "text_color": "#0A0A0A",
        "card_colors": [
          "#FFFFFF",
          "#C6FF3D"
        ],
        "card_padding_em": [
          0.08,
          0.3
        ],
        "card_radius_em": 0.12,
        "rotation_cycle_deg": [
          -4,
          3,
          -2,
          4
        ],
        "entrance": {
          "scale": [
            0.6,
            1.0
          ],
          "frames": 8,
          "ease": "back.out(1.7)"
        },
        "exit": {
          "frames": 2,
          "scale": [
            1.0,
            0.92
          ],
          "opacity": [
            1,
            0
          ]
        },
        "lead_frames": 2,
        "min_word_frames": 8,
        "max_chars_per_card": 10,
        "block_center_y_pct_h": 55
      },
      "sources": [
        8,
        15,
        19
      ]
    },
    {
      "id": "tilted-card-word-pop.sticker-shadow",
      "label": "Sticker with hard shadow",
      "look": "Adds a hard offset shadow and a thin black border",
      "params": {
        "card_shadow": "8px 8px 0 #0A0A0A",
        "card_border": "4px solid #0A0A0A"
      },
      "sources": []
    },
    {
      "id": "tilted-card-word-pop.calm-tilt",
      "label": "Calm tilt",
      "look": "Less bounce for brand-safe ads",
      "params": {
        "entrance": {
          "scale": [
            0.9,
            1.0
          ],
          "frames": 6,
          "ease": "power3.out"
        },
        "rotation_cycle_deg": [
          -2,
          2
        ]
      },
      "sources": [
        19
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
  "sources": [
    {
      "n": 1,
      "name": "Netflix — English (USA) Timed Text Style Guide",
