{
  "id": "white-card-captions",
  "name": "White card captions",
  "use": "Dark text on a clean white card with a soft shadow; the spoken word turns a strong blue.",
  "formats": [
    "16:9",
    "1:1",
    "9:16"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Inter",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter",
      "weights": [
        600,
        700
      ]
    },
    {
      "family": "Figtree",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Figtree",
      "weights": [
        600,
        700
      ]
    }
  ],
  "presets": [
    {
      "id": "white-card-captions.corporate-blue",
      "label": "Corporate blue",
      "look": "Inter 700 #111 on white card, active #1D4ED8",
      "params": {
        "canvas": "1920x1080",
        "font_family": "Inter",
        "font_weight": 700,
        "font_size_px": 56,
        "font_size_pct_h": 5.2,
        "text_color": "#111111",
        "active_color": "#1D4ED8",
        "card_color": "#FFFFFF",
        "card_padding_em": [
          0.45,
          0.7
        ],
        "card_radius_px": 20,
        "card_shadow": "0 8px 24px rgba(0,0,0,0.18)",
        "max_lines": 2,
        "max_chars_per_line": 42,
        "max_line_width_pct_w": 68,
        "entrance": {
          "opacity": [
            0,
            1
          ],
          "y_px": [
            6,
            0
          ],
          "frames": 6,
          "ease": "cubic-bezier(0.05,0.7,0.1,1)"
        },
        "lead_frames": 1
      },
      "sources": [
        1,
        4,
        8,
        18
      ]
    },
    {
      "id": "white-card-captions.warm-paper",
      "label": "Warm paper",
      "look": "Off-white card with warm accent",
      "params": {
        "card_color": "#FAF7F2",
        "text_color": "#111111",
        "active_color": "#C2410C"
      },
      "sources": [
        8
      ]
    },
    {
      "id": "white-card-captions.vertical-card",
      "label": "Vertical card",
      "look": "9:16 version at 60% height",
      "params": {
        "canvas": "1080x1920",
        "font_size_px": 64,
        "font_size_pct_h": 3.3,
        "card_max_width_px": 760,
        "block_center_y_pct_h": 60
      },
      "sources": [
        4,
        11
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
  "sources": [
    {
      "n": 1,
      "name": "Netflix — English (USA) Timed Text Style Guide",
