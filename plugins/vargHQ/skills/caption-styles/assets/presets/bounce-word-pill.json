{
  "id": "bounce-word-pill",
  "name": "Bouncing single-word pill",
  "use": "One uppercase word at a time bounces up inside a coloured pill (purple by default) near the centre of the frame.",
  "formats": [
    "9:16",
    "1:1"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Montserrat",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Montserrat",
      "weights": [
        900
      ]
    },
    {
      "family": "Archivo Black",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Archivo+Black",
      "weights": [
        400
      ]
    }
  ],
  "presets": [
    {
      "id": "bounce-word-pill.purple-spring",
      "label": "Purple spring",
      "look": "White caps word in a #6D28D9 pill, springs up from below",
      "params": {
        "font_family": "Montserrat",
        "font_weight": 900,
        "text_transform": "uppercase",
        "font_size_px": 120,
        "font_size_pct_h": 6.25,
        "letter_spacing_em": 0.02,
        "text_color": "#FFFFFF",
        "pill_color": "#6D28D9",
        "pill_padding_em": [
          0.12,
          0.45
        ],
        "pill_radius": "999px",
        "entrance": {
          "engine": "remotion.spring",
          "config": {
            "mass": 1,
            "damping": 10,
            "stiffness": 100
          },
          "durationInFrames": 12,
          "y_em": [
            0.6,
            0
          ],
          "scale": [
            0.85,
            1.0
          ]
        },
        "exit": {
          "frames": 2,
          "opacity": [
            1,
            0
          ]
        },
        "lead_frames": 2,
        "min_word_frames": 8,
        "block_center_y_pct_h": 58
      },
      "sources": [
        8,
        15,
        17
      ]
    },
    {
      "id": "bounce-word-pill.lime-spring",
      "label": "Lime spring",
      "look": "Black word on a lime pill",
      "params": {
        "pill_color": "#C6FF3D",
        "text_color": "#0A0A0A"
      },
      "sources": [
        8
      ]
    },
    {
      "id": "bounce-word-pill.soft-rise",
      "label": "Soft rise (no overshoot)",
      "look": "Calmer rise for brand and wellness",
      "params": {
        "entrance": {
          "engine": "remotion.spring",
          "config": {
            "mass": 1,
            "damping": 200,
            "stiffness": 100,
            "overshootClamping": true
          },
          "durationInFrames": 8,
          "y_em": [
            0.3,
            0
          ],
          "scale": [
            0.95,
            1.0
          ]
        }
      },
      "sources": [
        17
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
  "sources": [
