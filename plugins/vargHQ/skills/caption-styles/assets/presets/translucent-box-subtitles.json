{
  "id": "translucent-box-subtitles",
  "name": "Translucent box subtitles",
  "use": "Plain white sentence-case text on a semi-transparent dark box, one phrase or sentence at a time, cut on and cut off with no motion.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 7,
  "fonts": [
    {
      "family": "Inter",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter",
      "weights": [
        500,
        600
      ]
    },
    {
      "family": "Atkinson Hyperlegible",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Atkinson+Hyperlegible",
      "weights": [
        400,
        700
      ]
    }
  ],
  "presets": [
    {
      "id": "translucent-box-subtitles.broadcast-16x9",
      "label": "Broadcast 16:9",
      "look": "Inter 600 white on 75% black per-line box, bottom centre",
      "params": {
        "canvas": "1920x1080",
        "font_family": "Inter",
        "font_weight": 600,
        "font_size_px": 67,
        "font_size_pct_h": 6.25,
        "line_height": 1.2,
        "text_color": "#FFFFFF",
        "box_color": "rgba(0,0,0,0.75)",
        "box_padding_em": [
          0,
          0.5
        ],
        "box_radius_px": 0,
        "max_line_width_pct_w": 68,
        "max_chars_per_line": 42,
        "max_lines": 2,
        "bottom_margin_pct_h": 8,
        "align": "center",
        "entrance": "cut",
        "min_duration_s": 0.83,
        "max_duration_s": 7,
        "min_gap_frames": 2,
        "reading_rate_wpm": [
          160,
          180
        ]
      },
      "sources": [
        1,
        3,
        4,
        8
      ]
    },
    {
      "id": "translucent-box-subtitles.vertical-9x16",
      "label": "Vertical 9:16",
      "look": "Same box, larger lines, sits at ~60% height inside the platform safe box",
      "params": {
        "canvas": "1080x1920",
        "font_family": "Inter",
        "font_weight": 600,
        "font_size_px": 72,
        "font_size_pct_h": 3.75,
        "line_height": 1.2,
        "text_color": "#FFFFFF",
        "box_color": "rgba(0,0,0,0.72)",
        "box_padding_em": [
          0.04,
          0.5
        ],
        "box_radius_px": 6,
        "max_width_px": 696,
        "max_chars_per_line": 22,
        "max_lines": 3,
        "block_center_y_pct_h": 60,
        "block_bottom_max_px": 1248,
        "entrance": "cut",
        "min_duration_s": 0.83,
        "max_duration_s": 7
      },
      "sources": [
        4,
        10,
        11
      ]
    },
    {
      "id": "translucent-box-subtitles.soft-offblack",
      "label": "Soft off-black",
      "look": "Off-white on off-black, slightly rounded, for long podcasts",
      "params": {
        "font_family": "Atkinson Hyperlegible",
        "font_weight": 700,
        "text_color": "#FFFFF0",
        "box_color": "rgba(36,36,36,0.85)",
        "box_radius_px": 8,
        "box_padding_em": [
          0.06,
          0.5
        ],
        "max_lines": 2,
        "max_chars_per_caption": 60,
        "entrance": "cut"
      },
      "sources": [
        28,
        8
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
