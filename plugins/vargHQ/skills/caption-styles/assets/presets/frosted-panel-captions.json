{
  "id": "frosted-panel-captions",
  "name": "Frosted panel captions",
  "use": "White text on a blurred, frosted-glass panel; inactive words are dimmed and the spoken word is full white.",
  "formats": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Inter",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter",
      "weights": [
        600,
        700
      ]
    },
    {
      "family": "Manrope",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Manrope",
      "weights": [
        700
      ]
    }
  ],
  "presets": [
    {
      "id": "frosted-panel-captions.clear-dim",
      "label": "Clear glass with dim",
      "look": "Blur 20 px, dark 45% tint, white text with soft shadow",
      "params": {
        "font_family": "Inter",
        "font_weight": 700,
        "font_size_px": 80,
        "panel_fill": "rgba(18,18,22,0.45)",
        "backdrop_filter": "blur(20px) saturate(140%)",
        "panel_border": "1px solid rgba(255,255,255,0.22)",
        "panel_radius_px": 28,
        "panel_padding_em": [
          0.4,
          0.6
        ],
        "inactive_opacity": 0.8,
        "active_opacity": 1.0,
        "active_glow": "0 0 18px rgba(255,255,255,0.35)",
        "text_shadow": "0 1px 8px rgba(0,0,0,0.45)",
        "lead_frames": 1,
        "words_per_page": [
          3,
          6
        ],
        "max_width_px": 696,
        "max_width_note": "outer width of the glass panel; 9:16 centred maximum from the shared safe box",
        "bright_footage_note": "over bright mid-tones use the thick-bright-footage preset to keep 4.5:1"
      },
      "sources": [
        8,
        15,
        22,
        25
      ]
    },
    {
      "id": "frosted-panel-captions.thick-bright-footage",
      "label": "Thick glass for bright footage",
      "look": "Stronger dim and blur for snow, sky, white rooms",
      "params": {
        "panel_fill": "rgba(12,12,16,0.62)",
        "backdrop_filter": "blur(28px) saturate(120%)",
        "inactive_opacity": 0.75
      },
      "sources": [
        8,
        25
      ]
    },
    {
      "id": "frosted-panel-captions.light-glass",
      "label": "Light glass",
      "look": "Dark text on milky glass for bright, airy brands",
      "params": {
        "panel_fill": "rgba(255,255,255,0.62)",
        "backdrop_filter": "blur(24px)",
        "text_color": "#0A0A0A",
        "inactive_opacity": 0.55
      },
      "sources": [
        22,
        25
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
  "sources": [
    {
      "n": 1,
      "name": "Netflix — English (USA) Timed Text Style Guide",
      "url": "https://partnerhelp.netflixstudios.com/hc/en-us/articles/217350977-English-USA-Timed-Text-Style-Guide"
    },
    {
      "n": 3,
