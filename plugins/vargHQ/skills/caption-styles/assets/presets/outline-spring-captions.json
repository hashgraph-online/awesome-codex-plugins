{
  "id": "outline-spring-captions",
  "name": "Outlined spring-word captions",
  "use": "White words with a thick black outline; the spoken word turns cyan and springs up a few pixels, then settles.",
  "formats": [
    "9:16",
    "1:1"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Montserrat",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Montserrat",
      "weights": [
        900
      ]
    },
    {
      "family": "Anton",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Anton",
      "weights": [
        400
      ]
    }
  ],
  "presets": [
    {
      "id": "outline-spring-captions.cyan-spring",
      "label": "Cyan spring",
      "look": "Montserrat Black, 12 px outline, active cyan rising 0.12 em",
      "params": {
        "font_family": "Montserrat",
        "font_weight": 900,
        "font_size_px": 88,
        "font_size_pct_h": 4.6,
        "text_color": "#FFFFFF",
        "stroke_px": 12,
        "stroke_color": "#000000",
        "paint_order": "stroke fill",
        "drop_shadow": "0 5px 0 rgba(0,0,0,0.6)",
        "active_color": "#00FFFF",
        "active_rise_em": 0.12,
        "spring": {
          "mass": 1,
          "damping": 14,
          "stiffness": 180,
          "durationInFrames": 8
        },
        "release_frames": 4,
        "lead_frames": 1,
        "words_per_page": [
          2,
          4
        ]
      },
      "sources": [
        4,
        8,
        17,
        24
      ]
    },
    {
      "id": "outline-spring-captions.gaming-condensed",
      "label": "Gaming condensed",
      "look": "Anton caps, thicker outline, bigger rise",
      "params": {
        "font_family": "Anton",
        "text_transform": "uppercase",
        "font_size_px": 110,
        "stroke_px": 16,
        "active_rise_em": 0.18,
        "spring": {
          "mass": 1,
          "damping": 10,
          "stiffness": 100,
          "durationInFrames": 12
        }
      },
      "sources": [
        17,
        37
      ]
    },
    {
      "id": "outline-spring-captions.clean-outline",
      "label": "Clean outline",
      "look": "Thinner outline, no rise, colour change only",
      "params": {
        "stroke_px": 8,
        "drop_shadow": null,
        "active_rise_em": 0
      },
      "sources": [
        24
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
  "sources": [
