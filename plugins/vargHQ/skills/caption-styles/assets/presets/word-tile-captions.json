{
  "id": "word-tile-captions",
  "name": "Word tile captions",
  "use": "Every word sits on its own dark rounded tile; the spoken word's tile turns orange.",
  "formats": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Archivo Black",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Archivo+Black",
      "weights": [
        400
      ]
    },
    {
      "family": "Inter",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter",
      "weights": [
        800
      ]
    }
  ],
  "presets": [
    {
      "id": "word-tile-captions.orange-active",
      "label": "Orange active",
      "look": "Dark tiles, white words; active tile #FF7A1A with dark text",
      "params": {
        "font_family": "Archivo Black",
        "font_size_px": 78,
        "tile_color": "rgba(20,20,20,0.9)",
        "tile_padding_em": [
          0.1,
          0.26
        ],
        "tile_radius_em": 0.18,
        "tile_gap_em": 0.16,
        "text_color": "#FFFFFF",
        "active_tile_color": "#FF7A1A",
        "active_text_color": "#141414",
        "lead_frames": 1,
        "words_per_page": [
          3,
          4
        ],
        "max_width_px": 760
      },
      "sources": [
        8,
        15,
        21
      ]
    },
    {
      "id": "word-tile-captions.stagger-in",
      "label": "Stagger in",
      "look": "Tiles pop in left to right as the page appears",
      "params": {
        "entrance": {
          "scale": [
            0.85,
            1.0
          ],
          "opacity": [
            0,
            1
          ],
          "frames": 6,
          "ease": "cubic-bezier(0.05,0.7,0.1,1)",
          "stagger_frames": 2
        }
      },
      "sources": [
        18
      ]
    },
    {
      "id": "word-tile-captions.mono-tiles",
      "label": "Mono tiles",
      "look": "White tiles, black text, active tile black with white text",
      "params": {
        "tile_color": "#FFFFFF",
        "text_color": "#0A0A0A",
        "active_tile_color": "#0A0A0A",
        "active_text_color": "#FFFFFF"
      },
      "sources": [
        8
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
  "sources": [
    {
