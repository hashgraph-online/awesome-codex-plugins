{
  "id": "neon-tube-captions",
  "name": "Neon tube captions",
  "use": "Words glow like neon tubes (hot pink by default) inside a dark box with a glowing border.",
  "formats": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Nunito",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Nunito",
      "weights": [
        800,
        900
      ]
    },
    {
      "family": "Outfit",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Outfit",
      "weights": [
        700
      ]
    }
  ],
  "presets": [
    {
      "id": "neon-tube-captions.hot-pink",
      "label": "Hot pink",
      "look": "Pink halo, near-white core, pink border box",
      "params": {
        "font_family": "Nunito",
        "font_weight": 900,
        "font_size_px": 84,
        "text_color": "#FFE6F7",
        "inactive_text_shadow": "0 0 0.06em #FFFFFF, 0 0 0.3em #FF4FD8, 0 0 0.7em #FF4FD8",
        "active_text_shadow": "0 0 0.08em #FFFFFF, 0 0 0.12em #FFFFFF, 0 0 0.25em #FFFFFF, 0 0 0.5em #FF4FD8, 0 0 1.0em #FF4FD8, 0 0 1.2em #FF4FD8, 0 0 1.8em #FF4FD8",
        "box_color": "rgba(11,11,18,0.85)",
        "box_border": "3px solid #FF4FD8",
        "box_glow": "0 0 24px #FF4FD8, inset 0 0 18px rgba(255,79,216,0.35)",
        "box_radius_px": 22,
        "box_padding_em": [
          0.3,
          0.55
        ],
        "lead_frames": 1,
        "words_per_page": [
          2,
          4
        ]
      },
      "sources": [
        8,
        26
      ]
    },
    {
      "id": "neon-tube-captions.cyan-ice",
      "label": "Cyan ice",
      "look": "Cyan halo for tech/gaming",
      "params": {
        "halo_color": "#00FFFF",
        "text_color": "#E6FFFF",
        "box_border": "3px solid #00FFFF"
      },
      "sources": [
        4,
        8
      ]
    },
    {
      "id": "neon-tube-captions.pulse-only",
      "label": "Pulse only (no flicker)",
      "look": "Halo breathes 1 cycle per 2 s",
      "params": {
        "pulse": {
          "scale_min": 0.85,
          "scale_max": 1.15,
          "period_s": 2.0,
          "ease": "sine.inOut"
        },
        "flicker": false
      },
      "sources": [
        9,
        26
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
  "sources": [
    {
      "n": 1,
      "name": "Netflix — English (USA) Timed Text Style Guide",
      "url": "https://partnerhelp.netflixstudios.com/hc/en-us/articles/217350977-English-USA-Timed-Text-Style-Guide"
    },
    {
      "n": 3,
      "name": "Netflix — Timed Text Style Guide: Subtitle Timing Guidelines",
      "url": "https://partnerhelp.netflixstudios.com/hc/en-us/articles/360051554394-Timed-Text-Style-Guide-Subtitle-Timing-Guidelines"
    },
