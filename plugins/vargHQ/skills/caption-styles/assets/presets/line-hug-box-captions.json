{
  "id": "line-hug-box-captions",
  "name": "Line-hugging rounded box captions",
  "use": "Bold dark text on a white box whose rounded corners follow each line's own width, the native look of in-app text on vertical platforms.",
  "formats": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "duration_s": 7,
  "fonts": [
    {
      "family": "Plus Jakarta Sans",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Plus+Jakarta+Sans",
      "weights": [
        700,
        800
      ]
    },
    {
      "family": "Inter",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter",
      "weights": [
        700,
        800
      ]
    }
  ],
  "presets": [
    {
      "id": "line-hug-box-captions.white-box-classic",
      "label": "White box classic",
      "look": "#111 text on white per-line boxes with 0.28 em radius",
      "params": {
        "font_family": "Plus Jakarta Sans",
        "font_weight": 800,
        "font_size_px": 80,
        "font_size_pct_h": 4.2,
        "line_height": 1.22,
        "text_color": "#111111",
        "box_color": "#FFFFFF",
        "box_padding_em": [
          0.14,
          0.42
        ],
        "box_radius_em": 0.28,
        "box_decoration_break": "clone",
        "words_per_screen": [
          2,
          6
        ],
        "max_lines": 3,
        "max_width_px": 696,
        "block_center_y_pct_h": 62,
        "entrance": {
          "type": "scaleX",
          "from": 0.92,
          "to": 1,
          "frames": 6,
          "ease": "cubic-bezier(0.05,0.7,0.1,1)"
        }
      },
      "sources": [
        4,
        8,
        18,
        21
      ]
    },
    {
      "id": "line-hug-box-captions.black-box-inverse",
      "label": "Black box inverse",
      "look": "White text on black per-line boxes for bright footage",
      "params": {
        "font_family": "Plus Jakarta Sans",
        "font_weight": 800,
        "font_size_px": 80,
        "text_color": "#FFFFFF",
        "box_color": "#111111",
        "box_padding_em": [
          0.14,
          0.42
        ],
        "box_radius_em": 0.28,
        "box_decoration_break": "clone"
      },
      "sources": [
        8,
        21
      ]
    },
    {
      "id": "line-hug-box-captions.navy-pill-rise",
      "label": "Navy pill rise",
      "look": "Spaced caps in translucent navy pills; each line rises through a clip",
      "params": {
        "text_transform": "uppercase",
        "letter_spacing_px": [
          3,
          6
        ],
        "text_color": "#FFFFFF",
        "box_color": "rgba(6,20,40,0.62)",
        "box_radius": "999px",
        "box_decoration_break": "clone",
        "entrance": {
          "type": "clip-rise",
          "distance_x_line_height": 1.3,
          "frames": 10,
          "ease": "cubic-bezier(0.22,1,0.36,1)"
        }
      },
      "sources": [
        8,
        42
      ]
    },
    {
      "id": "line-hug-box-captions.brand-tint",
      "label": "Brand tint",
      "look": "Box in the brand colour, text auto-picked for >= 4.5:1",
      "params": {
        "box_color": "{brand}",
        "text_color": "auto_max_contrast(#111111,#FFFFFF)",
        "min_contrast": 4.5,
        "box_shadow": "0 6px 18px rgba(0,0,0,0.28)",
        "box_radius_em": 0.28
      },
      "sources": [
        8
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
