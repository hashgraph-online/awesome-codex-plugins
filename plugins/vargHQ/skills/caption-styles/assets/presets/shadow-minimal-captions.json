{
  "id": "shadow-minimal-captions",
  "name": "Shadow-only minimal captions",
  "use": "White text with a soft shadow and no box; the spoken word is just a little brighter than the rest.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 1,
  "fonts": [
    {
      "family": "Inter",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter",
      "weights": [
        500,
        600
      ]
    },
    {
      "family": "Figtree",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Figtree",
      "weights": [
        500,
        600
      ]
    }
  ],
  "presets": [
    {
      "id": "shadow-minimal-captions.soft-shadow",
      "label": "Soft shadow",
      "look": "Inter 600 white, 3-layer shadow, active 100% vs 80%",
      "params": {
        "font_family": "Inter",
        "font_weight": 600,
        "font_size_px_9x16": 76,
        "font_size_px_16x9": 60,
        "text_color": "#FFFFFF",
        "text_shadow": "0 0 2px rgba(0,0,0,0.9), 0 2px 8px rgba(0,0,0,0.6), 0 0 24px rgba(0,0,0,0.35)",
        "inactive_opacity": 0.8,
        "active_opacity": 1.0,
        "active_transition_frames": 2,
        "max_lines": 2,
        "lead_frames": 1
      },
      "sources": [
        4,
        6,
        8
      ]
    },
    {
      "id": "shadow-minimal-captions.cinema-lower",
      "label": "Cinema lower",
      "look": "16:9 film subtitle feel, smaller, wider tracking",
      "params": {
        "canvas": "1920x1080",
        "font_size_px": 52,
        "letter_spacing_em": 0.01,
        "bottom_margin_pct_h": 7,
        "max_line_width_pct_w": 68
      },
      "sources": [
        4
      ]
    },
    {
      "id": "shadow-minimal-captions.bright-guard",
      "label": "Bright-footage guard",
      "look": "Adds a soft gradient dim when the caption area is bright",
      "params": {
        "auto_dim": {
          "luma_threshold": 0.55,
          "gradient": "linear-gradient(to top, rgba(0,0,0,0.35), rgba(0,0,0,0))",
          "height_pct_h": 30
        }
      },
      "sources": [
        25
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
  "sources": [
    {
      "n": 1,
      "name": "Netflix — English (USA) Timed Text Style Guide",
      "url": "https://partnerhelp.netflixstudios.com/hc/en-us/articles/217350977-English-USA-Timed-Text-Style-Guide"
    },
    {
      "n": 3,
