{
  "id": "sliding-pill-captions",
  "name": "Sliding pill word tracker",
  "use": "A coloured pill slides from word to word behind white outlined text, marking the word being spoken while the text stays still.",
  "formats": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "duration_s": 7,
  "fonts": [
    {
      "family": "Montserrat",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Montserrat",
      "weights": [
        800,
        900
      ]
    },
    {
      "family": "Poppins",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Poppins",
      "weights": [
        800
      ]
    }
  ],
  "presets": [
    {
      "id": "sliding-pill-captions.electric-blue",
      "label": "Electric blue",
      "look": "Blue pill under white Montserrat with black outline",
      "params": {
        "font_family": "Montserrat",
        "font_weight": 900,
        "font_size_px": 84,
        "font_size_pct_h": 4.4,
        "text_color": "#FFFFFF",
        "stroke_px": 9,
        "stroke_color": "#000000",
        "paint_order": "stroke fill",
        "pill_color": "#1F5BFF",
        "pill_padding_em": [
          0.06,
          0.22
        ],
        "pill_radius_em": 0.5,
        "slide_frames": 5,
        "slide_ease": "cubic-bezier(0.2,0,0,1)",
        "lead_frames": 1,
        "words_per_page": [
          3,
          5
        ],
        "page_combine_ms": 1200,
        "max_width_px": 696,
        "block_center_y_pct_h": 60,
        "pill_box": "1em box centred on the glyphs (not the line box), plus pill_padding_em"
      },
      "sources": [
        8,
        15,
        16,
        18,
        24
      ]
    },
    {
      "id": "sliding-pill-captions.brand-pill",
      "label": "Brand pill",
      "look": "Pill in the brand colour, text colour chosen for >= 4.5:1",
      "params": {
        "pill_color": "{brand}",
        "active_text_color": "auto_max_contrast(#111111,#FFFFFF)",
        "slide_frames": 6,
        "min_contrast": 4.5
      },
      "sources": [
        8
      ]
    },
    {
      "id": "sliding-pill-captions.soft-pill",
      "label": "Soft pill",
      "look": "Smaller, 85% opacity pill and a slower slide for calm podcasts",
      "params": {
        "pill_color": "rgba(31,91,255,0.85)",
        "pill_padding_em": [
          0.04,
          0.16
        ],
        "slide_frames": 7,
        "slide_ease": "cubic-bezier(0.2,0,0,1)",
        "words_per_page": [
          4,
          6
        ],
        "pill_box": "1em box centred on the glyphs (not the line box), plus pill_padding_em"
      },
      "sources": [
        18
      ]
    }
  ],
  "shared": {
    "fps": 30,
    "safe_box_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "centered_max_width": 696
    },
    "safe_area_16x9_pct": {
      "vertical": 90,
      "horizontal": 75,
      "max_line_width_pct_w": 68
    },
    "reading_rate_wpm": [
      160,
      180
    ],
    "active_word_lead_frames": [
      1,
      2
    ],
    "min_contrast": 4.5
  },
