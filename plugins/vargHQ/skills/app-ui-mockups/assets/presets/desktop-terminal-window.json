{
  "id": "desktop-terminal-window",
  "name": "Desktop terminal window",
  "use": "An editable classic desktop terminal window (macOS Terminal-style) that types and runs a short session.",
  "formats": [
    "16:9",
    "1:1",
    "9:16"
  ],
  "duration_s": 6,
  "fonts": [
    {
      "family": "JetBrains Mono",
