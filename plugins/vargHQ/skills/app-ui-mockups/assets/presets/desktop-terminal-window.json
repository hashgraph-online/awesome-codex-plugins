      "family": "IBM Plex Mono",
      "weights": [
        400,
        600
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/IBM+Plex+Mono"
    },
    {
      "family": "Inter",
      "weights": [
        400,
        500,
        600
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter"
    }
  ],
  "trademark_note": "macOS and Terminal belong to Apple; SF Mono is Apple-licensed, so an OFL monospace is used. No Apple logo, invented user names.",
