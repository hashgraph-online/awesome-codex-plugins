{
  "id": "phone-message-thread",
  "name": "Phone message thread",
  "use": "A messaging-app conversation (iMessage-style bubbles) that plays out bubble by bubble for hooks, ads and stories.",
  "formats": [
    "9:16",
    "16:9",
    "1:1"
  ],
  "duration_s": 7,
  "fonts": [
    {
      "family": "Inter",
      "weights": [
        400,
        500,
        600
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter"
    },
    {
      "family": "Lato",
      "weights": [
        400,
        700
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Lato"
    }
  ],
  "trademark_note": "iMessage and the Messages UI belong to Apple. Look-alike only: no Apple logo, invented names, no fabricated reviews.",
  "presets": [
    {
      "id": "phone-message-thread.two-people",
      "label": "Two people",
      "look": "Light mode 1:1 chat, 6-8 bubbles",
      "params": {
        "bg": "#FFFFFF",
        "sent_bg": "#0b93f6",
        "sent_text": "#FFFFFF",
        "received_bg": "#e5e5ea",
        "received_text": "#000000",
        "bubble_radius_px_at_450w": 25,
        "bubble_padding_px": [
          10,
          20
        ],
        "bubble_max_width_pct_of_thread": 57,
        "gap_in_run_px": 2,
        "gap_between_runs_px": 15,
        "tail": "last bubble of a run only",
        "hold": "clamp(0.6 + chars/15, 1.0, 6.0) s",
        "typing_dots_s": 0.9,
        "bubble_in": {
          "duration_s": 0.12,
          "ease": "power2.out",
          "scale_from": 0.75,
          "opacity_from": 0.6,
          "origin": "sender bottom corner"
        },
        "scroll": {
          "duration_s": 0.3,
          "ease": "power2.inOut",
          "by": "new bubble height + gap"
        },
        "text_pct_frame_h": {
          "16:9": 3.2,
          "9:16": 3.6
        }
      },
      "sources": [
        33,
        61,
        11,
        12,
        13,
        2
      ]
    },
    {
      "id": "phone-message-thread.dark-typing",
      "label": "Typing (dark)",
      "look": "Dark mode with long typing waits for suspense",
      "params": {
        "bg": "#000000",
        "sent_bg": "#0a80f8",
        "received_bg": "#242428",
        "received_text": "#FFFFFF",
        "typing_dots": {
          "size_px_at_1080w": 14,
          "loop_s": 0.6,
          "phase_offset_s": 0.2,
          "opacity": [
            0.35,
            1
          ]
        },
        "typing_hold_s": [
          1.2,
          1.6
        ],
        "hold": "clamp(0.6 + chars/15, 1.0, 6.0) s"
      },
      "sources": [
        61,
        11,
        12
      ]
    },
    {
      "id": "phone-message-thread.group",
      "label": "Group chat",
      "look": "Names above received runs, avatars, no read receipts",
      "params": {
        "sender_name": {
          "color": "#8e8e93",
          "size_pct_frame_h": 1.6,
          "position": "above first bubble of a run"
        },
        "avatar_px_at_1080w": 28,
        "read_receipts": false,
        "hold": "clamp(0.6 + chars/15, 1.0, 6.0) s"
      },
      "sources": [
        35,
        33
      ]
    },
    {
      "id": "phone-message-thread.media",
      "label": "Photo, voice memo, link preview",
      "look": "Media bubbles inside the thread",
      "params": {
        "photo_radius": "same as bubble",
        "link_card": [
          "image 16:9",
          "title 600",
          "domain grey #8e8e93"
        ],
        "voice_memo_bars": 24,
        "media_hold_s": 2.0
      },
      "sources": [
        61,
        33
      ]
    },
    {
      "id": "phone-message-thread.reactions-receipt",
      "label": "Reactions + read receipt",
      "look": "Ends on a Tapback and 'Read' + time",
      "params": {
        "tapbacks": [
          "heart",
          "thumbs up",
          "thumbs down",
          "Ha Ha",
          "!!",
          "?"
        ],
        "one_per_message_per_person": true,
        "tapback_delay_after_bubble_s": [
          0.3,
          0.5
        ],
        "tapback_in": {
          "duration_s": 0.18,
          "ease": "back.out(2.2)",
          "scale_from": 0.6
        },
        "receipt": {
          "text": [
            "Delivered",
            "Read 9:41"
          ],
          "position": "under latest sent bubble",
          "fade_s": 0.2,
          "delay_s": 0.3,
          "group_chats": false
        }
      },
      "sources": [
        34,
        35
      ]
    },
    {
      "id": "phone-message-thread.huge-text",
      "label": "Huge texts",
      "look": "Oversized bubbles for 9:16 ads",
      "params": {
        "text_pct_frame_h": 5.2,
        "max_lines": 3,
        "bubble_max_width_pct_frame_w": 78,
        "safe_zone_9x16": {
          "x_pct": [
            6,
            94
          ],
          "y_pct": [
            14,
            80
          ]
        },
        "hold": "clamp(0.6 + chars/15, 1.0, 6.0) s"
      },
      "sources": [
        12,
        33
      ]
    }
  ],
  "sources": [
    {
      "n": 2,
      "name": "Emil Kowalski (@emilkowalski)",
      "url": "https://x.com/emilkowalski/status/1954891053032755560"
    },
    {
      "n": 11,
      "name": "Brysbaert 2019 reading-rate meta-analysis (BPS)",
      "url": "https://www.bps.org.uk/research-digest/most-comprehensive-review-date-finds-average-persons-reading-speed-slower"
    },
    {
      "n": 12,
      "name": "Netflix English (USA) Timed Text Style Guide",
      "url": "https://partnerhelp.netflixstudios.com/hc/en-us/articles/217350977-English-USA-Timed-Text-Style-Guide"
    },
    {
      "n": 13,
      "name": "Netflix Timed Text General Requirements",
      "url": "https://partnerhelp.netflixstudios.com/hc/en-us/articles/215758617-Timed-Text-Style-Guide-General-Requirements"
    },
    {
      "n": 33,
      "name": "Samuel Kraft, iOS chat bubbles in CSS",
      "url": "https://samuelkraft.com/blog/ios-chat-bubbles-css"
    },
    {
      "n": 34,
      "name": "Apple Support, Tapbacks",
      "url": "https://support.apple.com/en-euro/guide/messages/react-with-tapbacks-icht504f698a/14.0/mac/15.0"
    },
    {
      "n": 35,
      "name": "Apple Community, read receipts",
      "url": "https://discussions.apple.com/docs/DOC-250008552"
    },
    {
      "n": 61,
      "name": "HyperFrames chat-message",
      "url": "https://github.com/heygen-com/hyperframes/tree/main/registry/components/chat-message"
    }
  ]
}
