    {
      "id": "digital-glitch.corrupt",
      "label": "Corrupt",
      "look": "Codec-corruption look: a 384x96 region turns into 32 px posterized macroblocks, plus split and swapped blocks.",
      "params": {
        "macroblock_px": 32,
        "posterize_levels": 4,
        "corrupt_region_px": [
          384,
          96
        ],
        "hit_window_frames": 3,
        "hit_probability": 0.4,
        "rgb_split_px": 32,
        "datamosh_reference": {
          "blockSize": 48,
          "intensity": 0.7,
          "drift": 0.35,
          "churn": 0.4
        },
        "ffmpeg": {
          "inputs": [],
          "filter_complex": "[0:v]format=gbrp,split=3[ga][gb][gc];[ga]extractplanes=r,crop=w=iw-64:h=ih:x='32+if(lt((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453)),0.4),32*(2*(sin((floor(n/3))*78.233)*43758.5453-floor(sin((floor(n/3))*78.233)*43758.5453))-1),0)':y=0,pad=iw+64:ih:32:0,fillborders=left=32:right=32:mode=smear[gR];[gb]extractplanes=g[gG];[gc]extractplanes=b,crop=w=iw-64:h=ih:x='32-if(lt((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453)),0.4),32*(2*(sin((floor(n/3))*78.233)*43758.5453-floor(sin((floor(n/3))*78.233)*43758.5453))-1),0)':y=0,pad=iw+64:ih:32:0,fillborders=left=32:right=32:mode=smear[gB];[gG][gB][gR]mergeplanes=0x001020:gbrp,swaprect=w='w-120':h='if(lt((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453)),0.4),16+floor(64*(sin((floor(n/3))*78.233)*43758.5453-floor(sin((floor(n/3))*78.233)*43758.5453))),2)':x1=60:y1='floor((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453))*(h-88))':x2='if(lt((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453)),0.4),60+floor(120*((sin((floor(n/3))*39.425)*43758.5453-floor(sin((floor(n/3))*39.425)*43758.5453))-0.5)),60)':y2='floor((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453))*(h-88))+2',swaprect=w='if(lt((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453)),0.4),256,2)':h='if(lt((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453)),0.4),64,2)':x1='floor((sin((floor(n/3))*78.233)*43758.5453-floor(sin((floor(n/3))*78.233)*43758.5453))*(w-256))':y1='floor((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453))*(h-64))':x2='floor((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453))*(w-256))':y2='floor((sin((floor(n/3))*39.425)*43758.5453-floor(sin((floor(n/3))*39.425)*43758.5453))*(h-64))'[gm];[gm]split[gm1][gm2];[gm2]pixelize=w=32:h=32,lutrgb=r='floor(val/64)*64':g='floor(val/64)*64':b='floor(val/64)*64',crop=w=384:h=96:x='floor((sin((floor(n/3))*39.425)*43758.5453-floor(sin((floor(n/3))*39.425)*43758.5453))*(iw-384))':y='floor((sin((floor(n/3))*78.233)*43758.5453-floor(sin((floor(n/3))*78.233)*43758.5453))*(ih-96))'[gblk];[gm1][gblk]overlay=x='floor((sin((floor(n/3))*39.425)*43758.5453-floor(sin((floor(n/3))*39.425)*43758.5453))*(W-384))':y='floor((sin((floor(n/3))*78.233)*43758.5453-floor(sin((floor(n/3))*78.233)*43758.5453))*(H-96))':enable='lt((sin((floor(n/3))*12.9898)*43758.5453-floor(sin((floor(n/3))*12.9898)*43758.5453)),0.4)',format=yuv420p[v]"
        }
