      ]
    },
    {
      "id": "digital-glitch.jittery",
      "label": "Jittery",
      "look": "Footage stutters at 12 fps and the whole frame jumps up to 16 px on hits.",
      "params": {
        "stutter_fps": 12,
        "jitter_px": 16,
        "hit_window_frames": 1,
        "hit_probability": 0.5,
        "rgb_split_px": 12,
        "ffmpeg": {
          "inputs": [],
          "filter_complex": "[0:v]fps=12,fps=30,crop=w=iw-32:h=ih-32:x='16+if(lt((sin((floor(n/1))*12.9898)*43758.5453-floor(sin((floor(n/1))*12.9898)*43758.5453)),0.5),16*(2*(sin((floor(n/1))*78.233)*43758.5453-floor(sin((floor(n/1))*78.233)*43758.5453))-1),0)':y='16+if(lt((sin((floor(n/1))*12.9898)*43758.5453-floor(sin((floor(n/1))*12.9898)*43758.5453)),0.5),16*(2*(sin((floor(n/1))*39.425)*43758.5453-floor(sin((floor(n/1))*39.425)*43758.5453))-1),0)',scale=1920:1080,format=gbrp,split=3[ga][gb][gc];[ga]extractplanes=r,crop=w=iw-24:h=ih:x='12+if(lt((sin((floor(n/1))*12.9898)*43758.5453-floor(sin((floor(n/1))*12.9898)*43758.5453)),0.5),12*(2*(sin((floor(n/1))*78.233)*43758.5453-floor(sin((floor(n/1))*78.233)*43758.5453))-1),0)':y=0,pad=iw+24:ih:12:0,fillborders=left=12:right=12:mode=smear[gR];[gb]extractplanes=g[gG];[gc]extractplanes=b,crop=w=iw-24:h=ih:x='12-if(lt((sin((floor(n/1))*12.9898)*43758.5453-floor(sin((floor(n/1))*12.9898)*43758.5453)),0.5),12*(2*(sin((floor(n/1))*78.233)*43758.5453-floor(sin((floor(n/1))*78.233)*43758.5453))-1),0)':y=0,pad=iw+24:ih:12:0,fillborders=left=12:right=12:mode=smear[gB];[gG][gB][gR]mergeplanes=0x001020:gbrp,swaprect=w='w-32':h='if(lt((sin((floor(n/1))*12.9898)*43758.5453-floor(sin((floor(n/1))*12.9898)*43758.5453)),0.5),8+floor(24*(sin((floor(n/1))*78.233)*43758.5453-floor(sin((floor(n/1))*78.233)*43758.5453))),2)':x1=16:y1='floor((sin((floor(n/1))*12.9898)*43758.5453-floor(sin((floor(n/1))*12.9898)*43758.5453))*(h-40))':x2='if(lt((sin((floor(n/1))*12.9898)*43758.5453-floor(sin((floor(n/1))*12.9898)*43758.5453)),0.5),16+floor(32*((sin((floor(n/1))*39.425)*43758.5453-floor(sin((floor(n/1))*39.425)*43758.5453))-0.5)),16)':y2='floor((sin((floor(n/1))*12.9898)*43758.5453-floor(sin((floor(n/1))*12.9898)*43758.5453))*(h-40))+2',format=yuv420p[v]"
        }
      },
      "sources": [
        35,
