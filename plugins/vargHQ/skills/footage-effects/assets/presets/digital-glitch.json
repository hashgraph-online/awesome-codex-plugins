{
  "id": "digital-glitch",
  "name": "Digital glitch",
  "use": "Glitch real footage with RGB splits, torn rows, swapped blocks, stutter and macroblock corruption, in deterministic bursts.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 8,
  "fonts": [],
  "ffmpeg_note": "Chains target 1920x1080 at 30 fps: [0:v] is the footage, generated inputs are 1..n, output label [v]. For 9:16 swap 1920x1080 -> 1080x1920 in sizes and crops. Generated lavfi inputs never end, so always cap the output with -t <clip duration> (ffprobe format=duration). Encode with -c:v libx264 -crf 16 -preset slow -pix_fmt yuv420p and keep audio with -map '0:a?' -c:a copy.",
  "presets": [
    {
      "id": "digital-glitch.subtle",
      "label": "Subtle",
      "look": "Rare 2-frame hits: 8 px RGB split and one thin torn row. Brand-safe.",
      "params": {
        "hit_window_frames": 2,
        "hit_probability": 0.12,
        "hits_per_second_avg": 1.8,
        "rgb_split_px": 8,
        "row_tear_height_px": "8-40",
        "row_tear_shift_px": 20,
        "ffmpeg": {
          "inputs": [],
          "filter_complex": "[0:v]format=gbrp,split=3[ga][gb][gc];[ga]extractplanes=r,crop=w=iw-16:h=ih:x='8+if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.12),8*(2*(sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))-1),0)':y=0,pad=iw+16:ih:8:0,fillborders=left=8:right=8:mode=smear[gR];[gb]extractplanes=g[gG];[gc]extractplanes=b,crop=w=iw-16:h=ih:x='8-if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.12),8*(2*(sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))-1),0)':y=0,pad=iw+16:ih:8:0,fillborders=left=8:right=8:mode=smear[gB];[gG][gB][gR]mergeplanes=0x001020:gbrp,swaprect=w='w-40':h='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.12),8+floor(32*(sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))),2)':x1=20:y1='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(h-48))':x2='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.12),20+floor(40*((sin((floor(n/2))*39.425)*43758.5453-floor(sin((floor(n/2))*39.425)*43758.5453))-0.5)),20)':y2='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(h-48))+2',format=yuv420p[v]"
        },
        "hyperframes": {
          "data-color-grading": {
            "effects": {
              "digitalGlitch": 0.25,
              "digitalGlitchLineTear": 0.06,
              "digitalGlitchColorSplit": 0.1,
              "digitalGlitchSpeed": 0.5
            }
          }
        }
      },
      "sources": [
        29,
        34,
        10
      ]
    },
    {
      "id": "digital-glitch.default",
      "label": "Default",
      "look": "Bursts on ~30% of 2-frame windows: 24 px split, a sheared band, one swapped 240x48 block.",
      "params": {
        "hit_window_frames": 2,
        "hit_probability": 0.3,
        "rgb_split_px": 24,
        "band_height_px": "32-128",
        "band_shift_px": 40,
        "block_px": [
          240,
          48
        ],
        "ffmpeg": {
          "inputs": [],
          "filter_complex": "[0:v]format=gbrp,split=3[ga][gb][gc];[ga]extractplanes=r,crop=w=iw-48:h=ih:x='24+if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.3),24*(2*(sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))-1),0)':y=0,pad=iw+48:ih:24:0,fillborders=left=24:right=24:mode=smear[gR];[gb]extractplanes=g[gG];[gc]extractplanes=b,crop=w=iw-48:h=ih:x='24-if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.3),24*(2*(sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))-1),0)':y=0,pad=iw+48:ih:24:0,fillborders=left=24:right=24:mode=smear[gB];[gG][gB][gR]mergeplanes=0x001020:gbrp,swaprect=w='w-80':h='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.3),32+floor(96*(sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))),2)':x1=40:y1='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(h-136))':x2='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.3),40+floor(80*((sin((floor(n/2))*39.425)*43758.5453-floor(sin((floor(n/2))*39.425)*43758.5453))-0.5)),40)':y2='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(h-136))+2',swaprect=w='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.3),240,2)':h='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.3),48,2)':x1='floor((sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))*(w-240))':y1='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(h-48))':x2='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(w-240))':y2='floor((sin((floor(n/2))*39.425)*43758.5453-floor(sin((floor(n/2))*39.425)*43758.5453))*(h-48))',format=yuv420p[v]"
        }
      },
      "sources": [
        34,
        35,
        9,
        10
      ]
    },
    {
      "id": "digital-glitch.intense",
      "label": "Intense",
