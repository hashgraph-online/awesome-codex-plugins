          320,
          64
        ],
        "noise": 10,
        "max_duration_s": 1.5,
        "ffmpeg": {
          "inputs": [],
          "filter_complex": "[0:v]format=gbrp,split=3[ga][gb][gc];[ga]extractplanes=r,crop=w=iw-96:h=ih:x='48+if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.55),48*(2*(sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))-1),0)':y=0,pad=iw+96:ih:48:0,fillborders=left=48:right=48:mode=smear[gR];[gb]extractplanes=g[gG];[gc]extractplanes=b,crop=w=iw-96:h=ih:x='48-if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.55),48*(2*(sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))-1),0)':y=0,pad=iw+96:ih:48:0,fillborders=left=48:right=48:mode=smear[gB];[gG][gB][gR]mergeplanes=0x001020:gbrp,swaprect=w='w-240':h='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.55),64+floor(192*(sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))),2)':x1=120:y1='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(h-264))':x2='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.55),120+floor(240*((sin((floor(n/2))*39.425)*43758.5453-floor(sin((floor(n/2))*39.425)*43758.5453))-0.5)),120)':y2='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(h-264))+2',swaprect=w='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.55),320,2)':h='if(lt((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453)),0.55),64,2)':x1='floor((sin((floor(n/2))*78.233)*43758.5453-floor(sin((floor(n/2))*78.233)*43758.5453))*(w-320))':y1='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(h-64))':x2='floor((sin((floor(n/2))*12.9898)*43758.5453-floor(sin((floor(n/2))*12.9898)*43758.5453))*(w-320))':y2='floor((sin((floor(n/2))*39.425)*43758.5453-floor(sin((floor(n/2))*39.425)*43758.5453))*(h-64))',noise=alls=10:allf=t,format=yuv420p[v]"
        }
      },
      "sources": [
        34,
