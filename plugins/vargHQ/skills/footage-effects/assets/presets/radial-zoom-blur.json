{
  "id": "radial-zoom-blur",
  "name": "Radial zoom blur",
  "use": "Pull real footage into a zoom blur toward a centre, as a constant look, a beat punch, a fringed burst or light streaks.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 8,
  "fonts": [],
