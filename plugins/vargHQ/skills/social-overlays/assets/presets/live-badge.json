{
  "id": "live-badge",
  "name": "LIVE badge and viewer count",
  "use": "LIVE pill with pulsing dot and ticking viewer count in a corner.",
  "formats": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "duration_s": 6,
  "fonts": [
    {
      "family": "Inter",
      "weights": [
        700,
        800
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter"
    },
    {
      "family": "Roboto",
      "weights": [
        500,
        700
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Roboto"
    },
    {
      "family": "TikTok Sans",
      "weights": [
        700
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/TikTok+Sans"
    }
  ],
  "rules": [
    "Colours from owners where published [14][15][16]",
    "Label >=28 px bold for contrast [42]",
    "Real or clearly illustrative counts [21]",
    "3 significant figures, rounded down [13]",
    "9:16 badge at y>=300 [1][5]"
  ],
  "presets": [
    {
      "id": "live-badge.instagram-style",
      "label": "Instagram-style",
      "look": "Gradient pill + eye count chip",
      "params": {
        "pill_gradient": [
          "#DD2A7B",
          "#F58529"
        ],
        "gradient_note": "generic, no published hex found",
        "chip": "rgba(0,0,0,0.45)",
        "font": "Inter 800"
      },
      "sources": [
        17
      ]
    },
    {
      "id": "live-badge.tiktok-style",
      "label": "TikTok-style",
      "look": "Red pill + count chip",
      "params": {
        "pill": "#FE2C55",
        "text": "#FFFFFF",
        "contrast_white": "3.68:1 (large text only)",
        "chip": "rgba(0,0,0,0.4)",
        "font": "TikTok Sans 700"
      },
      "sources": [
        16,
        42
      ]
    },
    {
      "id": "live-badge.twitch-style",
      "label": "Twitch-style",
      "look": "Square red LIVE + red-dot count",
      "params": {
        "pill": "#EB0400",
        "radius_px": 4,
        "text": "#FFFFFF",
        "contrast_white": "4.62:1",
        "count_dot": "#EB0400",
        "accent": "#9147FF",
        "font": "Inter 700"
      },
      "sources": [
        15,
        42
      ]
    },
    {
      "id": "live-badge.youtube-style",
      "label": "YouTube-style",
      "look": "Red LIVE + watching count",
      "params": {
        "pill": "#FF0033",
        "text": "#FFFFFF",
        "contrast_white": "3.96:1 (large text only)",
        "chip": "rgba(33,33,33,0.8)",
        "font": "Roboto 700"
      },
      "sources": [
        14,
        42
      ]
    }
  ],
  "common": {
    "in_at_s": 0.2,
    "in_s": 0.3,
    "in_ease": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "slide_from_px": -24,
    "dot_pulse": {
      "period_s": 1.0,
      "scale": [
        1,
        1.35
      ],
      "opacity": [
        1,
        0.55
      ],
      "ease": "sine.inOut"
    },
    "count_tick": {
      "every_s": [
        0.9,
        1.4
      ],
      "step_pct": [
        0.3,
        2
      ],
      "roll_px": 8,
      "roll_s": 0.2,
      "ease": "power2.out",
      "rng": "seeded (mulberry32, fixed seed)"
    },
    "format": "<1000 exact; else 3 sig figs truncated + K/M",
    "numerals": "tabular-nums",
    "out_at_s": 5.7,
    "out_s": 0.2,
    "out_ease": "cubic-bezier(0.3, 0, 0.8, 0.15)",
    "size_1080x1920": {
      "pill_h_px": 56,
      "label_px": 30,
      "tracking_pct": 4,
      "dot_px": 14,
      "pos_px": [
        120,
        312
      ]
    },
    "size_1920x1080": {
      "pill_h_px": 44,
      "pos_px": [
        48,
        48
      ]
    }
  },
  "safe_zones": {
    "universal_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "below_y_840_max_x": 780
    },
    "tiktok_px": {
      "top": 240,
      "bottom": 660,
      "left": 120,
      "right": 120,
      "right_rail": {
        "x": [
          780,
          960
        ],
        "from_y": 840
      }
    },
    "reels_pct": {
      "top": 14,
      "bottom": 35,
      "sides": 6
    },
    "shorts_px": {
      "top": 288,
      "bottom": 672,
      "left": 48,
      "right": 192
    },
    "snap_px": {
      "top": 150,
      "bottom": 330
    },
    "landscape_margin_pct": 5
  },
  "trademark_note": "Platform names, logos and UI looks are trademarks of their owners; presets are generic 'inspired' looks, no logos.",
