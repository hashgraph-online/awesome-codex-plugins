{
  "id": "subscribe-nudge",
  "name": "Subscribe-and-bell nudge",
  "use": "Cursor clicks Subscribe, then the bell, as a short reminder overlay.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 5,
  "fonts": [
    {
      "family": "Roboto",
      "weights": [
        500,
        700
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Roboto"
    }
  ],
  "rules": [
    "Not in the intro [32]",
    "Ask at the end or after the payoff [33][34]",
    "Optional per video; no formula [35]",
    "Finish before the end-screen window (last 5-20 s) [8]",
    "Say 'subscribe' on the click frame [11]",
    "YouTube Red #FF0033, Almost Black #212121 [14]"
  ],
  "presets": [
    {
      "id": "subscribe-nudge.subscribe",
      "label": "Subscribe",
      "look": "Red pill flips to Subscribed",
      "params": {
        "button": "#FF0033",
        "label": "#FFFFFF",
        "label_px_1080p": 30,
        "label_weight": 700,
        "flipped_dark": "#272727 (house)",
        "flipped_light": "#E5E5E5 (house)",
        "card_px_16x9": [
          620,
          132
        ],
        "pos_px_16x9": [
          96,
          820
        ],
        "button_px_16x9": [
          236,
          72
        ],
        "in": [
          0,
          0.4
        ],
        "cursor": [
          0.4,
          1.1
        ],
        "press_s": 1.2,
        "flip_s": 1.3,
        "crossfade_s": 0.2,
        "out": [
          4.5,
          4.75
        ],
        "in_ease": "cubic-bezier(0.05, 0.7, 0.1, 1)",
        "out_ease": "cubic-bezier(0.3, 0, 0.8, 0.15)"
      },
      "sources": [
        14,
        26,
        42
      ]
    },
    {
      "id": "subscribe-nudge.subscribe-bell",
      "label": "Subscribe and bell",
      "look": "Plus bell click and decaying wiggle",
      "params": {
        "bell_px": 64,
        "bell_click_s": 2.3,
        "wiggle_deg": [
          0,
          15,
          -12,
          8,
          -4,
          0
        ],
        "wiggle_s": 0.5,
        "origin": "50% 8%"
      },
      "sources": []
    },
    {
      "id": "subscribe-nudge.highlight",
      "label": "Highlight",
      "look": "Avatar + name card, glow ring, no cursor",
      "params": {
        "glow": [
          "#FF0033",
          "#FFB400"
        ],
        "glow_s": 1.2,
        "glow_opacity": [
          0.6,
          0
        ]
      },
      "sources": [
        11
      ]
    },
    {
      "id": "subscribe-nudge.vertical",
      "label": "Vertical",
      "look": "9:16 stacked card, finger tap",
      "params": {
        "card_px": [
          760,
          150
        ],
        "button_px": [
          280,
          84
        ],
        "label_px": 34,
        "center_y_px": 1060,
        "safe": "Shorts 288/672/48/192"
      },
      "sources": [
        5
      ]
    }
