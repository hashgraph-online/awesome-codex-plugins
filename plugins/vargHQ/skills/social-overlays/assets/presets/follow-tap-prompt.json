{
  "id": "follow-tap-prompt",
  "name": "Follow tap prompt",
  "use": "Creator card whose Follow button gets clicked or tapped and flips to Following.",
  "formats": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "duration_s": 5,
  "fonts": [
    {
      "family": "Inter",
      "weights": [
        400,
        600,
        700
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter"
    },
    {
      "family": "TikTok Sans",
      "weights": [
        400,
        700
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/TikTok+Sans"
    }
  ],
  "rules": [
    "Ask after the payoff, not in the intro [32][33]",
    "Tie the ask to what they get [37]",
    "Show the state change [26]",
    "No fake follower counts [21]",
    "No platform logos; Instagram UI in commercials needs permission [17]"
  ],
  "presets": [
    {
      "id": "follow-tap-prompt.tiktok-style",
      "label": "TikTok-style",
      "look": "Dark card, red Follow pill, finger tap",
      "params": {
        "button": "#FE2C55",
        "label": "#FFFFFF",
        "card": "rgba(0,0,0,0.7)",
        "font": "TikTok Sans 700",
        "input": "tap",
        "card_px": [
          660,
          176
        ],
        "avatar_px": 112,
        "button_px": [
          200,
          72
        ],
        "button_radius_px": 36,
        "card_center_y_px": 740
      },
      "sources": [
        16
      ]
    },
    {
      "id": "follow-tap-prompt.instagram-style",
      "label": "Instagram-style",
      "look": "White card, blue Follow, cursor click",
      "params": {
        "button": "#0095F6",
        "button_color_status": "unverified starting value, sample from a current screenshot",
        "card": "#FFFFFF",
        "font": "Inter 600",
        "input": "cursor",
        "ring_gradient": "generic pink->orange, not a brand asset"
      },
      "sources": [
        17
      ]
    },
    {
      "id": "follow-tap-prompt.twitch-style",
      "label": "Twitch-style",
      "look": "Dark card, purple Follow with heart",
      "params": {
        "button": "#9147FF",
        "card": "rgba(24,24,27,0.9)",
        "font": "Inter 700",
        "input": "cursor"
      },
      "sources": [
        15
      ]
    },
    {
      "id": "follow-tap-prompt.x-style",
      "label": "X-style",
      "look": "Black/white pill",
      "params": {
        "button": "#000000",
        "label": "#FFFFFF",
        "card": "#FFFFFF",
        "font": "Inter 700",
        "input": "cursor"
      },
      "sources": []
    }
  ],
  "timeline_s": {
    "card_in": [
      0,
      0.45
    ],
    "cursor_travel": [
      0.45,
      1.2
    ],
    "press": 1.3,
    "flip": 1.4,
    "flip_crossfade_s": 0.2,
    "hold_until": 4.3,
    "out": [
      4.3,
      4.55
    ]
  },
  "eases": {
    "in": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "out": "cubic-bezier(0.3, 0, 0.8, 0.15)",
    "release": "back.out(1.7)",
    "cursor": "power2.inOut"
  },
  "safe_zones": {
    "universal_9x16_px": {
      "x": [
        120,
        888
      ],
      "y": [
        288,
        1248
      ],
      "below_y_840_max_x": 780
    },
    "tiktok_px": {
      "top": 240,
      "bottom": 660,
      "left": 120,
      "right": 120,
      "right_rail": {
        "x": [
          780,
          960
        ],
        "from_y": 840
      }
    },
    "reels_pct": {
      "top": 14,
      "bottom": 35,
      "sides": 6
    },
    "shorts_px": {
      "top": 288,
      "bottom": 672,
      "left": 48,
      "right": 192
    },
    "snap_px": {
      "top": 150,
      "bottom": 330
    },
    "landscape_margin_pct": 5
  },
  "trademark_note": "Platform names, logos and UI looks are trademarks of their owners; presets are generic 'inspired' looks, no logos.",
