{
  "id": "crt-scanline-title",
  "name": "CRT scanline title",
  "use": "A name and role that crash onto a CRT, then clear to clean type on a transparent frame.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 6,
  "fonts": [
    {
      "family": "VT323",
      "weights": [
        400
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/VT323"
    },
    {
      "family": "IBM Plex Mono",
      "weights": [
        400,
        500
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/IBM+Plex+Mono"
    }
  ],
  "presets": [
    {
      "id": "crt-scanline-title.consumer-tv",
      "label": "Consumer TV",
      "look": "Slot mask, soft beam, chroma bleed, vertical roll.",
      "params": {
        "scan_period_px_1080p": 4.5,
        "scan_dark_fraction": 0.45,
        "hardScan": -8,
        "hardPix": -3,
        "warp": [
          0.031,
          0.041
        ],
        "maskDark": 0.5,
        "maskLight": 1.5,
        "mask": "slot",
        "bloom": 0.15,
        "chroma_shift_px": 2,
        "timeline_s": {
          "power_on": [
            0,
            0.2
          ],
          "noise": [
            0.2,
            0.6
          ],
          "type_in": [
            0.6,
            1.2
          ],
          "crt_hold": [
            1.2,
            3.4
          ],
          "clear": [
            3.4,
            3.8
          ],
          "clean_hold": [
            3.8,
            6.0
          ]
        },
        "rgb_offset_px": [
          8,
          1
        ],
        "jitter_px": 2,
        "name": "VT323 9% H",
        "role": "IBM Plex Mono 500 3.2% H",
        "text": "#E9FFF1",
        "tube_black": "#050607",
        "output": "alpha (ProRes 4444 / VP9 alpha)"
      },
      "sources": [
        21,
        36,
        46,
        14
      ]
    },
    {
      "id": "crt-scanline-title.arcade-monitor",
      "label": "Arcade monitor",
      "look": "Sharp RGB monitor, aperture grille, little bleed.",
      "params": {
        "scan_period_px_1080p": 4,
        "scan_dark_fraction": 0.55,
        "mask": "aperture-grille",
        "triad_px": 3,
        "chroma_shift_px": 0,
        "bloom": 0.1,
        "warp": [
          0.02,
          0.03
        ]
      },
      "sources": [
        21
      ]
    },
    {
      "id": "crt-scanline-title.terminal-green",
      "label": "Terminal green",
      "look": "Monochrome phosphor terminal with persistence.",
      "params": {
        "text": "#33FF66",
        "bg": "#031A0B",
        "font": "VT323",
        "persistence": "ffmpeg lagfun decay=0.9",
        "scan_period_px_1080p": 4,
        "glow": "0 0 6px rgba(51,255,102,.6)"
      },
      "sources": [
        22,
        21
      ]
    }
  ],
  "sources": [
    {
