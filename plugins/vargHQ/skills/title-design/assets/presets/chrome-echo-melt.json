{
  "id": "chrome-echo-melt",
  "name": "Chrome echo melt",
  "use": "A single chrome word that melts into stepped echoes, blurs into a grainy halo and dissolves.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 6,
  "fonts": [
    {
      "family": "Unbounded",
      "weights": [
        800,
        900
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Unbounded"
    },
    {
      "family": "Archivo Black",
      "weights": [
        400
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Archivo+Black"
    }
  ],
  "presets": [
    {
      "id": "chrome-echo-melt.ice",
      "label": "Ice",
      "look": "Cold silver-blue chrome with a blue halo.",
      "params": {
        "gradient_deg": 180,
        "stops": [
          [
            "#FFFFFF",
            5
          ],
          [
            "#9FD8FF",
            25
          ],
          [
            "#05070A",
            50
          ],
          [
            "#FFFFFF",
            51
          ],
          [
            "#1A4CFF",
            75
          ],
          [
            "#020308",
            95
          ]
        ],
        "hard_horizon": "50% -> 51%",
        "halo": "#6FB8FF",
        "rgb_split_px": {
          "rest": [
            1,
            2
          ],
          "melt_peak": 8
        },
        "echoes": {
          "count": 8,
          "spacing_f": 2,
          "opacity_decay": 0.7,
          "drift_px_per_step": 8,
          "blend": "screen"
        },
        "blur_chain": [
          "radial 8-12%",
          "gaussian sigma 24-48 px",
          "rgb-split blur 2-4 px"
        ],
        "grain_opacity": [
          0.08,
          0.12
        ],
        "font": "Unbounded 900",
        "size": "16-20% H",
        "tracking_em": -0.02,
        "timeline_s": {
          "form": [
            0,
            1.2
          ],
          "hold_sweep": [
            1.2,
            3.0
          ],
          "melt": [
            3.0,
            5.0
          ],
          "dissolve": [
            5.0,
            6.0
          ]
        },
        "bg": "#050506"
      },
      "sources": [
        26,
        27,
        38,
        32,
        39,
        37,
        29
      ]
    },
