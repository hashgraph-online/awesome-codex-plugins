{
  "id": "globe-country-dive",
  "name": "Globe-to-country dive",
  "use": "A globe turns and zooms onto one country, which lights up and gets a label.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 9,
  "fonts": [
    {
      "family": "Inter",
      "weights": [
        500,
        800
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter"
    },
    {
      "family": "Fraunces",
      "weights": [
        600,
        700
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Fraunces"
    }
  ],
  "shared": {
    "fps": 30,
    "camera_path": {
      "model": "van Wijk & Nuij",
      "rho": 1.42,
      "scale_interpolation": "exponential (log space)",
      "center_interpolation": "d3.geoInterpolate great arc"
    },
    "zoom_rate_zl_per_s": 1.0,
    "beats_s": {
      "globe_in": [
        0.0,
        1.2
      ],
      "telegraph": [
        1.2,
        2.0
      ],
      "dive": [
        2.0,
        6.3
      ],
      "reveal": [
        6.3,
        7.2
      ],
      "label": [
        7.2,
        7.8
      ],
      "hold": [
        7.8,
        9.0
      ]
    },
    "dive_ease": "cubic-bezier(0.65, 0, 0.35, 1)",
    "enter_ease": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "rotation_done_at_dive_fraction": 0.7,
    "idle_spin_deg_per_s": 4,
    "globe_diameter": {
      "16:9": "84% of height",
      "9:16": "78% of width",
      "1:1": "80% of side"
    },
    "final_fit_padding_pct": 12,
    "neighbour_dim_opacity": 0.35,
    "label_size_pct_h": 6.5,
    "sublabel_size_pct_h": 2.6,
    "attribution": {
      "size_pct_h": 1.5,
      "opacity": 0.7,
      "corner": "bottom-right",
      "min_visible_s": 3
    },
    "projection_end": "conic (Albers/LCC) if country spans > 15 deg, else orthographic",
    "data": "Natural Earth 1:110m globe, 1:50m close-up (public domain)"
  },
  "presets": [
    {
      "id": "globe-country-dive.night-globe",
      "label": "Night globe",
      "look": "Dark space, city-lights globe, warm gold country",
      "params": {
        "bg": "#05070D",
        "texture": "NASA Black Marble 2016, 13500x6750",
        "atmosphere_rim": "#3A6EA5 @ 35%",
        "fog": {
          "horizon_blend": 0.02,
          "star_intensity": 0.6,
          "space_color": "rgb(11,11,25)"
        },
        "highlight": "#FFC861",
        "highlight_border_px": 3,
        "highlight_glow_px": 12,
        "borders": "#2B3A55 0.75px",
        "label_font": "Inter 800",
        "label_color": "#FFFFFF",
        "credit": "NASA Earth Observatory; © OpenStreetMap contributors only if OSM data used"
      },
      "sources": [
        10,
        12,
        16,
        19,
        26,
        27,
        46
      ]
    },
    {
      "id": "globe-country-dive.atlas-paper",
      "label": "Atlas paper",
      "look": "Printed atlas: paper ocean, cream land, terracotta country",
      "params": {
        "ocean": "#DCE7EA",
        "land": "#F3EEE2",
        "borders": "#9A8F7E 1px",
        "graticule": "#BFCBD0 0.5px every 15deg",
        "highlight": "#C8553D",
        "label_font": "Fraunces 700",
        "label_color": "#2B2620",
        "credit": "none required (Natural Earth)"
      },
      "sources": [
        5,
        12,
        20,
        24,
        46
      ]
    },
    {
      "id": "globe-country-dive.flat-brand",
      "label": "Flat brand",
      "look": "Flat two-tone globe in brand colours",
      "params": {
        "ocean": "brand.bg",
        "land": "brand.bg lightened 12%",
        "highlight": "brand.accent",
        "texture": null,
        "label_font": "Inter 700"
      },
      "sources": [
        5,
        12,
        46
      ]
    }
  ],
  "sources": [
