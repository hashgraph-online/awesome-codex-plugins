{
  "id": "versus-timeline",
  "name": "Versus timeline",
  "use": "Two values move in opposite directions on a shared axis while a year counter ticks, ending with a gap callout.",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 8,
  "fonts": [
    {
      "family": "Inter",
      "weights": [
        500,
        800
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter"
    },
    {
      "family": "Source Serif 4",
      "weights": [
        600,
        700
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Source+Serif+4"
    }
  ],
  "shared": {
    "fps": 30,
    "beats_s": {
      "title": [
        0.0,
        0.6
      ],
      "run": [
        0.6,
        6.4
      ],
      "settle": [
        6.4,
        6.8
      ],
      "gap_callout": [
        6.8,
        7.4
      ],
      "hold": [
        7.4,
        8.0
      ]
    },
    "time_mapping": "linear years; ease only first/last 0.3 s (power1)",
    "years_per_s": [
      3,
      6
    ],
    "years_per_s_max": 8,
    "year_display": "integers only, tabular-nums",
    "value_interpolation": "linear between yearly points",
    "scale": "shared y; index to 100 if units differ (no dual axis)",
    "labels": "values ride line tips, colour-matched; or narrative legend in subtitle",
    "label_collision": "push apart if tips closer than 1.2x label height, add leader line",
    "line_px": [
      5,
      6
    ],
    "end_dot_px": 14,
    "value_pct_h": [
      4.5,
      6
    ],
    "year_pct_h": [
      7,
      9
    ],
    "pair_lightness_gap_oklch": 0.2,
    "gap_format": "signDisplay: exceptZero, 2-3 significant digits",
    "enter_ease": "cubic-bezier(0.05, 0.7, 0.1, 1)"
  },
  "presets": [
    {
      "id": "versus-timeline.light-paper",
      "label": "Light paper",
      "look": "Warm paper, black type, blue rising vs orange falling",
      "params": {
        "bg": "#F6F1E7",
        "text": "#1A1A1A",
        "grid": "#E2DBCD 1px",
        "series_a": "#1F4E9A",
        "series_b": "#E07A1F",
        "year_font": "Source Serif 4 700",
        "year_pct_h": 9
      },
      "sources": [
        1,
        36,
        40,
        42
      ]
    },
    {
      "id": "versus-timeline.dark-ink",
      "label": "Dark ink",
      "look": "Near-black, bright pair, big ghosted year behind the plot",
      "params": {
        "bg": "#0E0F12",
        "text": "#F2F2F2",
        "grid": "#24272E 1px",
        "series_a": "#4FD1C5",
        "series_b": "#F6AD55",
        "ghost_year_pct_h": 28,
        "ghost_year_opacity": 0.08
      },
      "sources": [
        1,
        3,
        36,
        43
      ]
    },
    {
      "id": "versus-timeline.footage-overlay",
      "label": "Footage overlay",
      "look": "Over b-roll: scrim, big numbers, mini lines below",
      "params": {
        "scrim": "#000 @ 55%",
        "numbers_pct_h": 10,
        "number_font": "Inter 800 tnum",
        "mini_chart_pct_h": 30,
        "series_a": "#7CC4FF",
        "series_b": "#FFB86B"
      },
      "sources": [
        43,
        50,
        51
      ]
    }
  ],
  "sources": [
    {
