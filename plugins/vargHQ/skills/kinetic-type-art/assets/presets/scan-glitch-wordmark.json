{
  "id": "scan-glitch-wordmark",
  "name": "Scanned-sheet glitch wordmark",
  "use": "A wordmark on a scanned sheet that holds, breaks up in short glitch bursts, and settles clean",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 4,
  "fonts": [
    {
      "family": "Inter",
      "weights": [
        800
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter"
    },
    {
      "family": "Archivo",
      "weights": [
        900
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Archivo"
    }
  ],
  "presets": [
    {
      "id": "scan-glitch-wordmark.paper",
      "label": "Paper",
      "look": "Black wordmark on scanned off-white with grain",
      "params": {
        "bg": "#F2EFE8",
        "ink": "#111111",
        "grain_pct": 12,
        "hold_clean_f": 30,
        "bursts_s": [
          1.0,
          2.0,
          2.8
        ],
        "burst_len_f": [
          3,
          8
        ],
        "slices": [
          4,
          12
        ],
        "slice_offset_px": [
          10,
          80
        ],
        "rgb_split_px": [
          4,
          12
        ],
        "smear_px": [
          40,
          120
        ],
        "smear_opacity": [
          0.6,
          0.8
        ],
        "glyph_flip": {
          "per_letter_s": 0.2,
          "stagger_s": 0.05,
          "letters_per_burst": [
            1,
            3
          ]
        },
        "interpolation": "steps(1) per frame",
        "final_clean_hold_f": 24,
        "wordmark_width_pct_16x9": [
          50,
          70
        ],
        "ffmpeg_burst": "rgbashift=rh=8:bh=-8:enable='between(t,1.0,1.2)',tmix=frames=3:weights='1 1 2':enable='between(t,1.0,1.2)',noise=alls=12:allf=t+u"
      },
      "sources": [
        3,
        53,
        31,
        33,
        41
      ]
    },
    {
      "id": "scan-glitch-wordmark.night",
      "label": "Night",
      "look": "Inverted scan, red and cyan tears",
      "params": {
        "bg": "#0B0B0D",
        "ink": "#F2EFE8",
        "rgb_split": {
          "r_px": 8,
          "b_px": -8
        }
      },
      "sources": [
        41,
        33
      ]
    },
    {
      "id": "scan-glitch-wordmark.newsprint",
      "label": "Newsprint",
      "look": "Grey newsprint, halftone, heavy smear",
      "params": {
        "bg": "#E9E4D8",
        "ink": "#1A1A1A",
        "halftone_dot_px": 2,
        "smear_px": [
          40,
          120
        ],
        "paper_shader": "halftone-overlay"
      },
      "sources": [
        42,
        32
      ]
    }
  ],
  "sources": [
    {
      "n": 3,
      "name": "@jh3yy, glyph flip glitch",
      "url": "https://x.com/jh3yy/status/1762979019446698310"
    },
    {
      "n": 31,
      "name": "Envato Tuts+, photocopy and xerox textures",
      "url": "https://design.tutsplus.com/tutorials/how-to-create-photocopy-and-xerox-textures--cms-109034"
    },
    {
      "n": 32,
      "name": "Parker Higgins, automated datamoshing",
      "url": "https://parkerhiggins.net/2017/07/making-mosh-ups-automated-datamoshing-from-multiple-video-sources/"
    },
    {
      "n": 33,
      "name": "FFmpeg filters documentation",
      "url": "https://ffmpeg.org/ffmpeg-filters.html"
    },
    {
      "n": 41,
      "name": "HyperFrames registry",
      "url": "https://github.com/heygen-com/hyperframes/tree/main/registry"
    },
    {
      "n": 42,
      "name": "vargHQ/skills paper-shaders",
      "url": "https://github.com/vargHQ/skills/tree/main/paper-shaders"
    },
    {
      "n": 53,
      "name": "Art of the Title, Se7en (Kyle Cooper)",
      "url": "https://www.artofthetitle.com/title/se7en/"
    }
  ]
}
