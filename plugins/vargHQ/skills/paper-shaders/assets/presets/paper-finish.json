{
  "id": "paper-finish",
  "label": "Paper texture finish",
  "shader": "PaperTexture",
  "page": "https://shaders.paper.design/paper-texture",
  "paperShaders": "0.0.82",
  "use": "Paper grain, fiber and soft folds over a still or a title card. Static; without an image it renders the paper alone.",
  "image": {
    "role": "still",
    "required": false,
    "note": "the image printed on the paper; same origin, or CORS headers"
  },
  "motion": {
    "timeScale": 0,
    "frame": 0
  },
  "roles": {
    "colorBack": "base",
    "colorPaper": "paper",
    "colorShadow": "shadow"
  },
  "params": {
    "image": "",
    "colorBack": "#070708",
    "colorPaper": "#f4efe6",
    "colorShadow": "#9c8a70",
    "blending": 0.5,
    "distortion": 0.3,
    "clip": false,
    "angle": 300,
    "seed": 4,
    "roughness": 0.4,
    "roughnessSize": 0.5,
    "roughnessRows": 0,
    "fiber": 0.3,
    "fiberSize": 0.5,
    "folds": 0.2,
    "foldSizeX": 1,
    "foldSizeY": 1,
    "foldOffsetX": 0,
    "foldOffsetY": 0,
    "wrinkles": 0.3,
    "wrinkleSize": 0.65,
    "crumples": 0,
    "crumpleCount": 6,
    "drops": 0.2,
    "fit": "cover",
    "scale": 1,
    "rotation": 0,
    "offsetX": 0,
    "offsetY": 0,
    "originX": 0.5,
    "originY": 0.5,
    "worldWidth": 0,
    "worldHeight": 0
  }
}
