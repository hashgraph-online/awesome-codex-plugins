{
  "id": "contour-lines",
  "name": "Contour lines",
  "use": "A topographic map whose terrain slowly reshapes, for data, travel, outdoor and strategy stories",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 10,
  "fonts": [
    {
      "family": "IBM Plex Mono",
      "weights": [
        500
      ],
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/IBM+Plex+Mono"
    }
  ],
  "presets": [
    {
      "id": "contour-lines.signature",
      "label": "Signature",
      "look": "Bone lines on charcoal, brighter index contours",
      "params": {
        "engine": "custom-glsl",
        "heightfield": "fbm(p*freq + vec2(0.0, t*drift)) + 0.35*fbm(p*freq*0.5 + 4.0*q)",
        "fbmOctaves": 5,
        "fbmGain": 0.5,
        "lacunarity": 2.01,
        "octaveRotationRad": 0.5,
        "freq": 1.6,
        "drift": 0.04,
        "levels": 22,
        "indexEvery": 5,
        "minorWidthPx1080": 1.4,
        "indexWidthPx1080": 2.8,
        "aa": "de = abs(fract(h*levels+0.5)-0.5)/fwidth(h*levels); line = 1.0-smoothstep(w-0.75, w+0.75, de)",
        "levelScroll": "h += 0.015*t  // lines march slowly uphill",
        "minLineSpacingPx": 6,
        "background": "#121212",
        "minor": "#EDE6D866",
        "index": "#EDE6D8"
      },
      "sources": [
        21,
        22,
        23,
        25,
        34
      ]
    },
    {
      "id": "contour-lines.survey",
      "label": "Survey",
      "look": "USGS-style brown contours on map cream, heavier index lines",
      "params": {
        "engine": "custom-glsl",
        "heightfield": "fbm(p*freq + vec2(0.0, t*drift)) + 0.35*fbm(p*freq*0.5 + 4.0*q)",
        "fbmOctaves": 5,
        "fbmGain": 0.5,
        "lacunarity": 2.01,
        "octaveRotationRad": 0.5,
        "freq": 1.6,
        "drift": 0.04,
        "levels": 22,
        "indexEvery": 5,
        "minorWidthPx1080": 1.4,
        "indexWidthPx1080": 2.8,
        "aa": "de = abs(fract(h*levels+0.5)-0.5)/fwidth(h*levels); line = 1.0-smoothstep(w-0.75, w+0.75, de)",
        "levelScroll": "h += 0.015*t  // lines march slowly uphill",
        "minLineSpacingPx": 6,
        "background": "#F3EBDC",
        "minor": "#A0703F99",
        "index": "#8B5A2B",
        "labelFont": "IBM Plex Mono 500, 18 px at 1080p"
      },
      "sources": [
        23,
        34
      ]
    },
    {
      "id": "contour-lines.night",
      "label": "Night",
      "look": "Cyan contours on blue-black with a soft glow on index lines",
      "params": {
        "engine": "custom-glsl",
        "heightfield": "fbm(p*freq + vec2(0.0, t*drift)) + 0.35*fbm(p*freq*0.5 + 4.0*q)",
        "fbmOctaves": 5,
        "fbmGain": 0.5,
        "lacunarity": 2.01,
        "octaveRotationRad": 0.5,
        "freq": 1.6,
        "drift": 0.04,
        "levels": 22,
        "indexEvery": 5,
        "minorWidthPx1080": 1.4,
        "indexWidthPx1080": 2.8,
        "aa": "de = abs(fract(h*levels+0.5)-0.5)/fwidth(h*levels); line = 1.0-smoothstep(w-0.75, w+0.75, de)",
        "levelScroll": "h += 0.015*t  // lines march slowly uphill",
        "minLineSpacingPx": 6,
        "background": "#050B14",
        "minor": "#7FD4FF59",
        "index": "#7FD4FF",
        "glow": {
          "radiusPx": 6,
          "opacity": 0.35
        }
      },
      "sources": [
        23,
        24
      ]
    },
    {
      "id": "contour-lines.blueprint",
      "label": "Blueprint",
      "look": "White contours and a 64 px grid on blueprint blue",
      "params": {
        "engine": "custom-glsl",
        "heightfield": "fbm(p*freq + vec2(0.0, t*drift)) + 0.35*fbm(p*freq*0.5 + 4.0*q)",
        "fbmOctaves": 5,
        "fbmGain": 0.5,
        "lacunarity": 2.01,
        "octaveRotationRad": 0.5,
        "freq": 1.6,
        "drift": 0.04,
        "levels": 22,
        "indexEvery": 5,
