  "paperFallback": {
    "note": "Paper has no contour shader. For filled elevation bands (terraces) instead of lines use SimplexNoise with stepsPerColor 10 and softness 0.",
    "paper": {
      "shader": "SimplexNoise",
      "motion": {
        "timeScale": 0.3,
        "frame": 0
      },
      "paper": {
        "fit": "contain",
        "scale": 0.6,
        "rotation": 0,
        "offsetX": 0,
        "offsetY": 0,
        "originX": 0.5,
        "originY": 0.5,
        "worldWidth": 0,
        "worldHeight": 0,
        "colors": [
          "#121212",
          "#2A2A2A"
        ],
        "stepsPerColor": 10,
        "softness": 0
      }
    }
  }
