{
  "id": "mesh-gradient-grain",
  "name": "Mesh gradient with grain",
  "use": "Slow-blending colour fields with film grain behind titles, cards and lower thirds",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 10,
  "fonts": [],
  "presets": [
    {
      "id": "mesh-gradient-grain.signature",
      "label": "Signature",
      "look": "Indigo, navy, coral and blush, deep base between the complementary hues",
      "params": {
        "engine": "paper-shaders@0.0.82",
        "shader": "MeshGradient",
        "motion": {
          "timeScale": 0.3,
          "frame": 0
        },
        "paper": {
          "fit": "contain",
          "scale": 1,
          "rotation": 0,
          "offsetX": 0,
          "offsetY": 0,
          "originX": 0.5,
          "originY": 0.5,
          "worldWidth": 0,
          "worldHeight": 0,
          "colors": [
            "#3A2BD9",
            "#0B1026",
            "#FF6A3D",
            "#F6C7B6"
          ],
          "distortion": 0.8,
          "swirl": 0.1,
          "grainMixer": 0.1,
          "grainOverlay": 0.15
        }
      },
      "sources": [
        18,
