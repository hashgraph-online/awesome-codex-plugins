{
  "id": "marbled-ink",
  "name": "Marbled ink",
  "use": "Colours folding into each other like marbled ink, for title backgrounds and interstitials",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 10,
  "fonts": [],
  "presets": [
    {
      "id": "marbled-ink.signature",
      "label": "Signature",
      "look": "Lavender and ink veins combed through warm white",
      "params": {
        "engine": "paper-shaders@0.0.82",
        "shader": "Warp",
        "motion": {
          "timeScale": 1.0,
          "frame": 0
        },
        "paper": {
          "fit": "contain",
          "scale": 1.2,
          "rotation": 30,
          "offsetX": 0,
          "offsetY": 0,
          "originX": 0.5,
          "originY": 0.5,
          "worldWidth": 0,
          "worldHeight": 0,
          "colors": [
            "#141218",
            "#E9E4DA",
            "#8C7BD8",
            "#E9E4DA"
          ],
          "proportion": 0.35,
          "softness": 0.15,
          "distortion": 0.25,
          "swirl": 0.85,
          "swirlIterations": 10,
          "shape": "stripes",
          "shapeScale": 0.3
        }
      },
      "sources": [
        3,
        18,
        20,
        21
      ]
    },
    {
