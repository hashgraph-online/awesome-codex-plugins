    },
    {
      "n": 40,
      "name": "Wikipedia: Paper marbling",
      "url": "https://en.wikipedia.org/wiki/Paper_marbling"
    },
    {
      "n": 42,
      "name": "Ken Perlin: Noise and Turbulence",
      "url": "https://mrl.cs.nyu.edu/~perlin/doc/oscar.html"
    }
  ],
  "customGLSL": {
    "technique": "IQ domain warping f = fbm(p + 4.0*r), r = fbm2(p + 4.0*q + offsets), q = fbm2(p)",
    "offsets": {
      "q": [
        [
          0,
          0
        ],
        [
          5.2,
          1.3
        ]
      ],
      "r": [
        [
          1.7,
          9.2
        ],
        [
          8.3,
          2.8
        ]
      ]
    },
    "warpGain": 4.0,
    "fbm": {
      "octaves": 5,
      "gain": 0.5,
      "lacunarity": 2.0,
      "rotationPerOctaveRad": 0.5,
      "shift": 100
    },
    "timeDrift": {
      "r.x": "0.15*t",
      "r.y": "0.126*t"
    },
    "colour": "mix(c0,c1,clamp(f*f*4,0,1)) -> mix(.,c2,clamp(length(q),0,1)) -> mix(.,c3,clamp(r.x,0,1))",
    "sources": [
      21,
      22,
      25
    ]
  }
}
