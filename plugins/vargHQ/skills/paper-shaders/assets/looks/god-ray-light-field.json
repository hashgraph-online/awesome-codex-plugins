    {
      "id": "god-ray-light-field.bright-core",
      "label": "Bright core",
      "look": "Large white-hot core, strong bloom, short rays; reveal ramp over 1.2 s",
      "params": {
        "engine": "paper-shaders@0.0.82",
        "shader": "GodRays",
        "motion": {
          "timeScale": 0.6,
          "frame": 0
        },
        "paper": {
          "fit": "contain",
          "scale": 1,
          "rotation": 0,
          "offsetX": 0,
          "offsetY": 0,
          "originX": 0.5,
          "originY": 0.5,
          "worldWidth": 0,
          "worldHeight": 0,
          "colorBack": "#060B1C",
          "colorBloom": "#4D7DFF",
          "colors": [
            "#4D7DFF7A",
            "#CFE0FFF0",
            "#FFFFFF"
          ],
          "density": 0.3,
          "spotty": 0.3,
          "midSize": 0.35,
          "midIntensity": 0.95,
          "intensity": 0.85,
          "bloom": 0.8
        },
        "grainLayer": {
          "type": "svg-feTurbulence",
          "baseFrequency": 0.65,
          "numOctaves": 3,
          "opacity": 0.08,
          "blend": "overlay",
          "seed": "floor(seconds*24)",
          "note": "or HyperFrames grain-overlay component"
        },
        "paramsAt": "intensity = 0.85*easeOutCubic(min(t/1.2,1)); midIntensity = 0.95*easeOutCubic(min(t/1.2,1))"
      },
      "sources": [
        18,
        20,
        31
      ]
