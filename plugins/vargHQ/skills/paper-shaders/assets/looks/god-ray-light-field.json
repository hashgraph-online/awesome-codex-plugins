{
  "id": "god-ray-light-field",
  "name": "God-ray light field",
  "use": "Rays from a bright core, graded blue, with film grain, behind a title or a reveal",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 10,
  "fonts": [],
  "presets": [
    {
      "id": "god-ray-light-field.overhead",
      "label": "Overhead",
      "look": "Shafts falling from above the top edge into deep navy",
      "params": {
        "engine": "paper-shaders@0.0.82",
        "shader": "GodRays",
        "motion": {
          "timeScale": 0.4,
          "frame": 0
        },
        "paper": {
          "fit": "contain",
          "scale": 1,
          "rotation": 0,
          "offsetX": 0,
          "offsetY": -0.8,
          "originX": 0.5,
          "originY": 0.5,
          "worldWidth": 0,
          "worldHeight": 0,
          "colorBack": "#050A18",
          "colorBloom": "#8FB4FF",
          "colors": [
            "#3D7BFF66",
            "#9CC2FFB3",
            "#FFFFFF"
          ],
          "density": 0.35,
          "spotty": 0.3,
          "midSize": 0.15,
          "midIntensity": 0.6,
          "intensity": 0.75,
          "bloom": 0.5
        },
        "grainLayer": {
          "type": "svg-feTurbulence",
          "baseFrequency": 0.65,
          "numOctaves": 3,
          "opacity": 0.08,
          "blend": "overlay",
          "seed": "floor(seconds*24)",
          "note": "or HyperFrames grain-overlay component"
        }
      },
      "sources": [
        18,
        20,
        30,
        31
      ]
    },
