        "boil": {
          "stepMs": 80,
          "fps": 12.5,
          "drawings": 8,
          "seed": "mod(floor(t/0.08), 8.0)"
        },
        "rotationDegPerS": 0,
        "lineWobblePx1080": 3,
        "background": "#FBFAF4",
        "ink": "#231F20",
        "paperGrain": 0.15
