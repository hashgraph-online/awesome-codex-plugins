{
  "id": "hand-drawn-radial-burst",
  "name": "Hand-drawn radial burst",
  "use": "A blocky, dithered sunburst of rays that boils like hand-drawn animation, for hooks, reveals and title cards",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 8,
  "fonts": [],
  "presets": [
    {
      "id": "hand-drawn-radial-burst.signature",
      "label": "Signature",
      "look": "Cream rays on warm black, 8-drawing boil at 12.5 fps",
      "params": {
        "engine": "custom-glsl",
        "rays": 32,
        "rayWidthJitter": 0.45,
        "rayLengthJitter": 0.35,
        "radialSteps": 12,
        "blockPx1080": 8,
        "dither": "bayer4x4",
        "ditherCellPx1080": 4,
        "falloff": "tone = 1.0 - smoothstep(0.05, 1.1, r)",
        "boil": {
          "stepMs": 80,
          "fps": 12.5,
          "drawings": 8,
          "seed": "mod(floor(t/0.08), 8.0)"
        },
        "rotationDegPerS": 0,
        "lineWobblePx1080": 3,
        "background": "#141210",
        "ink": "#F2EEE3"
      },
      "sources": [
        15,
        26,
        27,
        29,
        38
      ]
    },
    {
      "id": "hand-drawn-radial-burst.print",
      "label": "Print",
      "look": "Black ink on newsprint, finer 8x8 dither, paper grain",
      "params": {
        "engine": "custom-glsl",
        "rays": 32,
        "rayWidthJitter": 0.45,
        "rayLengthJitter": 0.35,
        "radialSteps": 12,
        "blockPx1080": 8,
