          "originX": 0.5,
          "originY": 0.5,
          "worldWidth": 0,
          "worldHeight": 0,
          "colorBack": "#0B0B0F",
          "colorFront": "#9CC2FF",
          "shape": "warp",
          "type": "4x4",
          "size": 3
        },
        "mount": {
          "minPixelRatio": 1
        }
      },
      "sources": [
        17,
        18,
        20,
        27
      ]
    },
