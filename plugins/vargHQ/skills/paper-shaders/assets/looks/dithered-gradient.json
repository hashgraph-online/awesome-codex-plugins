{
  "id": "dithered-gradient",
  "name": "Dithered gradient",
  "use": "A moving two-tone field dithered like print or an old screen, for interstitials and end cards",
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_s": 10,
  "fonts": [],
  "presets": [
    {
      "id": "dithered-gradient.signature",
      "label": "Signature",
      "look": "Pale blue ink on near-black, 4x4 Bayer over a warped field",
      "params": {
        "engine": "paper-shaders@0.0.82",
        "shader": "Dithering",
        "motion": {
          "timeScale": 0.5,
          "frame": 0
        },
        "paper": {
          "fit": "contain",
