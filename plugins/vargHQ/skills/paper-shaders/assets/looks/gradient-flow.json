  "loop": {
    "method": "crossfade",
    "seconds": 1.0,
    "mainFrameMs": 60000,
    "copyFrameMs": "60000 - L*1000*timeScale",
    "note": "Paper time is not periodic; crossfade the main clip into the offset copy over the last 1 s so frame L equals frame 0"
  }
}
