{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$HOME/.codex/vibestretch}/scripts/vibestretch.sh\" start codex",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$HOME/.codex/vibestretch}/scripts/vibestretch.sh\" check codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$HOME/.codex/vibestretch}/scripts/vibestretch.sh\" stop codex",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
