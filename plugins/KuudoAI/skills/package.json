{
  "name": "@kuudoai/skills-repository",
  "version": "0.11.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm --prefix tooling ci",
    "skill:new": "tooling/node_modules/.bin/tsx tooling/src/cli.ts new",
    "validate": "tooling/node_modules/.bin/tsx tooling/src/cli.ts validate",
    "catalog:build": "tooling/node_modules/.bin/tsx tooling/src/cli.ts catalog build",
    "catalog:check": "tooling/node_modules/.bin/tsx tooling/src/cli.ts catalog check",
    "version:bump": "bash scripts/bump-version.sh",
    "version:check": "bash scripts/bump-version.sh --check",
    "version:audit": "bash scripts/bump-version.sh --audit",
    "skills:version-check": "tooling/node_modules/.bin/tsx tooling/src/cli.ts version-check",
    "commits:check": "tooling/node_modules/.bin/tsx tooling/src/cli.ts commit-check",
    "evals:export": "tooling/node_modules/.bin/tsx tooling/src/cli.ts evals export",
    "package": "bash scripts/package.sh",
    "smoke": "tooling/node_modules/.bin/tsx --test tooling/test/smoke.test.ts",
    "typecheck": "tooling/node_modules/.bin/tsc --noEmit",
    "test:unit": "tooling/node_modules/.bin/tsx --test tooling/test/*.test.ts",
    "test": "npm run typecheck && npm run test:unit && npm run validate && npm run catalog:check"
  }
}
