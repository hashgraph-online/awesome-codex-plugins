{
  "_comment": "Amazon Ads API v1 CreateReport \u2014 Sponsored Products Targeting equivalent of the v3 SP Targeting report. The v3 report is split into TWO v1 reports because metric.topOfSearchImpressionShare is incompatible with portfolio/adGroup/country dimensions (validator-confirmed) and requires adProduct.value + advertiserAccount.id. Submit both, join on date + campaign.id downstream. Replace placeholders before submitting.",
  "report_1_main_targeting": {
    "accessRequestedAccounts": [
      {
        "advertiserAccountId": "amzn1.ads-account.g.REPLACE_ME"
      }
    ],
    "reports": [
      {
        "format": "GZIP_JSON",
        "query": {
          "fields": [
            "date.value",
            "portfolio.portfolioId",
            "portfolio.name",
            "campaign.id",
            "campaign.name",
            "campaign.currencyCode",
            "adGroup.id",
            "adGroup.name",
            "country.code",
            "country.name",
            "target.value",
            "target.matchType",
            "budgetCurrency.value",
            "metric.impressions",
            "metric.clicks",
            "metric.ctr",
            "metric.cpc",
            "metric.totalCost",
            "metric.sales",
            "metric.purchases",
            "metric.unitsSold",
            "metric.purchaseRate",
            "metric.purchaseRateOverClicks",
            "metric.unitsSoldPromoted",
            "metric.unitsSoldHalo",
            "metric.salesPromoted",
            "metric.salesHalo",
            "metric.roas"
          ],
          "filter": {
            "on": {
              "comparisonOperator": "EQUALS",
              "field": "adProduct.value",
              "not": false,
              "values": [
                "SPONSORED_PRODUCTS"
              ]
            }
          }
        },
        "periods": [
          {
            "datePeriod": {
              "startDate": "START_DATE",
              "endDate": "END_DATE"
            }
          }
        ]
      }
    ]
  },
  "report_2_top_of_search_impression_share": {
    "accessRequestedAccounts": [
      {
        "advertiserAccountId": "amzn1.ads-account.g.REPLACE_ME"
      }
    ],
    "reports": [
      {
        "format": "GZIP_JSON",
        "query": {
          "fields": [
            "date.value",
            "campaign.id",
            "campaign.name",
            "advertiserAccount.id",
            "adProduct.value",
            "budgetCurrency.value",
            "metric.impressions",
            "metric.topOfSearchImpressionShare"
          ],
          "filter": {
            "on": {
              "comparisonOperator": "EQUALS",
              "field": "adProduct.value",
              "not": false,
              "values": [
                "SPONSORED_PRODUCTS"
              ]
            }
          }
        },
        "periods": [
          {
            "datePeriod": {
              "startDate": "START_DATE",
              "endDate": "END_DATE"
            }
          }
        ]
      }
    ]
  }
}
