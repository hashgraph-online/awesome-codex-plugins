  "repository": "https://github.com/cerredz/vidbyte-memory",
  "license": "MIT",
  "keywords": [
    "memory",
    "agent-memory",
    "correction-driven-memory",
    "agents-md",
    "agent-skills",
    "tests",
    "git",
    "claude-code",
    "codex",
    "human-in-the-loop"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "vidbyte-memory",
        "shortDescription": "Memory that learns from your corrections, enforced by tests.",
        "developerName": "cerredz",
        "category": "Developer Tools",
        "privacyPolicyURL": "https://github.com/cerredz/vidbyte-memory/blob/main/PRIVACY.md"
