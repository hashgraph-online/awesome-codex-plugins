{
  "name": "steinwall",
  "version": "0.1.1",
  "description": "Guardian for coding agents (Claude Code, Codex): cost brake, action guard, loop rescue, limit handoff. Spend less. Break nothing.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxxstm/steinwall.git"
  },
  "homepage": "https://github.com/maxxstm/steinwall#readme",
  "bugs": "https://github.com/maxxstm/steinwall/issues",
  "mcpName": "io.github.maxxstm/steinwall",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "steinwall": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:lite": "npm run build && node scripts/package-lite.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "cost",
    "budget",
    "guardrails",
    "security",
    "mcp",
    "plugin"
  ],
  "files": [
    "dist/",
    "hooks/",
    "commands/",
    "skills/",
    "agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/",
    "assets/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ]
}
