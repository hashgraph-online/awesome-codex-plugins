{
  "mcpServers": {
    "codex_attachment_manager": {
      "command": "./scripts/launch",
      "args": ["./src/plugin-server.ts"],
      "cwd": ".",
      "default_tools_approval_mode": "approve",
      "env_vars": [
        "CODEX_HOME",
        "CAM_DATA_DIR",
        "CAM_ENGINE_PORT",
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "https_proxy",
        "http_proxy",
        "all_proxy",
        "no_proxy",
        "HOME",
        "XDG_CACHE_HOME",
        "XDG_DATA_HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "APPDATA",
        "PATH",
        "SYSTEMROOT",
        "WINDIR",
        "TEMP",
        "TMP"
      ],
      "startup_timeout_sec": 20
    }
  }
}
