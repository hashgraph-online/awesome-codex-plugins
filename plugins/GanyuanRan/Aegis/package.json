{
  "name": "aegis",
  "version": "2.8.3",
  "type": "module",
  "main": ".opencode/plugins/aegis.js",
  "keywords": [
    "pi-package",
    "agent-skills",
    "aegis",
    "method-pack",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "dsh": {
