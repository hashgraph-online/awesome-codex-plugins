{
  "name": "espresso",
  "version": "2.3.0",
  "description": "Concise output without sacrificing evidence or uncertainty.",
  "author": {
    "name": "Mirko Bozzetto",
    "url": "https://github.com/mirkobozzetto"
  },
  "homepage": "https://github.com/mirkobozzetto/espresso",
  "repository": "https://github.com/mirkobozzetto/espresso",
  "license": "MIT",
  "keywords": [
    "concise",
    "ponytail",
    "token-efficiency",
    "codex",
    "claude-code"
  ],
  "interface": {
    "displayName": "Espresso",
    "shortDescription": "Concise, evidence-preserving output with bundled Ponytail.",
    "developerName": "Mirko Bozzetto",
    "category": "Productivity",
    "websiteURL": "https://github.com/mirkobozzetto/espresso",
    "brandColor": "#1f6548",
    "composerIcon": "./assets/icon.svg",
    "logo": "./assets/icon.svg"
  },
  "skills": "./skills",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/src/hooks/ponytail.js\" SessionStart",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/src/hooks/espresso-remind.js\"",
              "timeout": 5
            },
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/src/hooks/ponytail.js\" UserPromptSubmit",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}
