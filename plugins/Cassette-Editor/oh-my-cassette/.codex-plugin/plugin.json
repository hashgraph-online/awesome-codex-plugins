{
  "name": "oh-my-cassette",
  "version": "0.5.0",
  "description": "Edit video with the Cassette agent from Codex: import local media, send editing turns, read the timeline, export.",
  "author": {
    "name": "Oh My Cassette contributors",
    "url": "https://github.com/Cassette-Editor/oh-my-cassette"
  },
  "homepage": "https://github.com/Cassette-Editor/oh-my-cassette",
  "repository": "https://github.com/Cassette-Editor/oh-my-cassette",
  "license": "MIT",
  "keywords": [
    "cassette",
    "video-editing",
    "media",
    "mcp",
    "codex",
    "claude"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "cassette": {
      "command": "uvx",
      "args": [
        "oh-my-cassette==0.5.0"
      ],
      "env": {},
      "env_vars": [
        "CASSETTE_MCP_URL",
        "CASSETTE_AUTH_TOKEN",
        "CASSETTE_WORKSPACE",
        "CASSETTE_ALLOWED_ROOTS",
        "CASSETTE_DOWNLOAD_DIR",
        "CASSETTE_MAX_UPLOAD_MB",
        "CASSETTE_LOCAL_WAIT_SEC",
        "CASSETTE_FFMPEG",
        "CASSETTE_FFPROBE",
        "CASSETTE_TEMP_DIR",
        "OH_MY_CASSETTE_LOG"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 600
    }
  },
  "interface": {
    "displayName": "Oh My Cassette",
    "shortDescription": "Edit video with the Cassette agent",
    "longDescription": "Open or create a Cassette project, import local media, relay the user's editing requests to the Cassette agent one turn at a time, review edits in the browser through links, undo, redo or revert a turn, and export the final video.",
    "developerName": "Oh My Cassette contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Read",
      "Write"
    ],
    "websiteURL": "https://github.com/Cassette-Editor/oh-my-cassette",
    "privacyPolicyURL": "https://cassette-editor.github.io/oh-my-cassette/privacy",
    "termsOfServiceURL": "https://cassette-editor.github.io/oh-my-cassette/terms",
    "logo": "./assets/logo-400.png",
    "composerIcon": "./assets/logo-400.png",
    "screenshots": [],
    "defaultPrompt": [
      "Edit this project video with Cassette.",
      "Let me choose the Cassette model for this edit.",
      "Add captions and background music to this clip.",
      "Revert the last Cassette turn."
    ],
    "brandColor": "#6D5EF5"
  }
}
