{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-format.py\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 0,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" --portable-only",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
