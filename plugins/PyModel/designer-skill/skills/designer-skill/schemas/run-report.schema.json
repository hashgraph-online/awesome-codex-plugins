{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Designer run report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "mode",
    "inputRevision",
    "outputRevision",
    "inputHash",
    "taskStatus",
    "uiReadiness",
    "checks",
    "findings",
    "changes",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mode": {
      "enum": [
        "audit",
        "plan",
        "refine",
        "implement",
        "system"
      ]
    },
    "inputRevision": {
      "type": "string",
      "minLength": 1
    },
    "outputRevision": {
      "type": "string",
      "minLength": 1
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "taskStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "uiReadiness": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_VERIFIED"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "required",
          "status",
          "reason",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["static", "functional", "accessibility", "rendered"]
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact",
                "sha256",
                "producer",
                "revision",
                "origin"
              ],
              "properties": {
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "producer": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "enum": [
                    "executed",
                    "observed",
                    "attested"
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "required": {
                  "const": true
                },
                "status": {
                  "const": "PASS"
                }
              },
              "required": [
                "required",
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "contains": {
                    "properties": {
                      "origin": {
                        "enum": [
                          "executed",
                          "observed"
                        ]
                      }
                    },
                    "required": [
                      "origin"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "blocking",
          "resolved",
          "summary",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor",
              "advisory"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "resolved": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact",
                "sha256",
                "producer",
                "revision",
                "origin"
              ],
              "properties": {
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "producer": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "enum": [
                    "executed",
                    "observed",
                    "attested"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "changes": {
      "description": "Implementation changes only; authorized planning/report artifacts belong in evidence.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "uiReadiness": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "type": "object",
              "properties": {
                "kind": { "const": "rendered" },
                "required": { "const": true },
                "status": { "const": "PASS" },
                "evidence": {
                  "contains": {
                    "properties": { "origin": { "const": "observed" } },
                    "required": ["origin"]
                  }
                }
              },
              "required": ["kind", "required", "status", "evidence"]
            },
            "items": {
              "if": {
                "properties": {
                  "required": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "NOT_APPLICABLE"
                    ]
                  }
                }
              }
            }
          },
          "findings": {
            "items": {
              "if": {
                "properties": {
                  "blocking": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "resolved": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": ["audit", "plan"]
          }
        }
      },
      "then": {
        "properties": {
          "changes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taskStatus": {
            "const": "COMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "if": {
                "properties": {
                  "required": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "status": {
                    "not": {
                      "const": "NOT_RUN"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taskStatus": {
            "const": "COMPLETE"
          },
          "mode": {
            "enum": [
              "refine",
              "implement",
              "system"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "uiReadiness": {
            "const": "PASS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taskStatus": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "taskStatus"
        ]
      },
      "then": {
        "properties": {
          "uiReadiness": {
            "not": {
              "const": "PASS"
            }
          }
        }
      }
    }
  ]
}
