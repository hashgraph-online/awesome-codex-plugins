{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Designer host-owned verification plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "mode", "inputRevision", "outputRevision", "inputHash", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "enum": ["audit", "plan", "refine", "implement", "system"] },
    "inputRevision": { "type": "string", "minLength": 1 },
    "outputRevision": { "type": "string", "minLength": 1 },
    "inputHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "allowNotApplicable"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "kind": { "enum": ["static", "functional", "accessibility", "rendered"] },
          "allowNotApplicable": { "type": "boolean" }
        }
      }
    }
  }
}
