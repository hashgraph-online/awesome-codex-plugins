{
  "name": "dejavu-gates",
  "version": "2.56.0",
  "description": "Cross-session error gates for AI coding agents: detects recurring tool-call failures and promotes them into enforced gates. Remind first, block on same-session repeat offense. Works with OpenCode, Claude Code, Codex CLI, Gemini CLI, Cursor, Copilot CLI, and Crush.",
  "type": "module",
  "main": "index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "cline": {
    "plugins": [
      {
        "paths": [
          "./src/cline-plugin.ts"
        ],
        "capabilities": [
          "hooks"
        ]
      }
    ]
  },
  "bin": {
    "dejavu": "./bin/dejavu.mjs",
    "dejavu-gates": "./bin/dejavu.mjs"
  },
  "files": [
    "index.ts",
    "bin",
    "src",
    "vendor",
    "hooks",
    ".claude-plugin",
    ".cursor-plugin",
    "gemini-extension.json",
    "plugin.json",
    "scripts",
    "commands",
    "skills",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "llms-full.txt",
    "AGENTS.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "copilot-cli",
    "crush",
    "ai-agents",
    "coding-agent",
    "error-gates",
    "hooks",
    "memory",
    "reliability",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WhiteBite/dejavu-gates.git"
  },
  "homepage": "https://github.com/WhiteBite/dejavu-gates",
  "bugs": "https://github.com/WhiteBite/dejavu-gates/issues",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test/smoke.ts",
    "lint:ast": "ast-grep scan",
    "rdk:audit": "rdk audit",
    "rdk:fix": "rdk fix"
  },
  "license": "MIT",
  "engines": {
    "opencode": ">=1.18.29",
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "@opencode/plugin": "^2.0.18",
    "@types/node": "^24.0.0",
    "repo-aeo": "^0.3.4",
    "typescript": "^5.5.0"
  }
}
