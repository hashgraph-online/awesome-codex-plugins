+    @staticmethod
+    def _number_groups(typesetting_units):
+        """Keep signs, decimals and exponents in the same physical line.
+
+        A sign and its value can occupy separate formula/text units. Only group
+        complete units so a larger equation or prose unit is never split here.
+        """
+        text, starts, ends = "", {}, {}
+        for i, unit in enumerate(typesetting_units):
+            value = unit.try_get_unicode()
+            if value is None and unit.formular:
+                value = "".join(c.char_unicode or "" for c in unit.formular.pdf_character)
+            value = value or "\ufffc"
+            starts[len(text)] = i
+            text += value
+            ends[len(text)] = i + 1
+        groups = {}
+        pattern = r"(?<![A-Za-z0-9_.])[+\-\u2212]?(?:[0-9]+(?:[.,][0-9]+)*|[.,][0-9]+)(?:[eE][+\-\u2212]?[0-9]+)?"
+        for match in re.finditer(pattern, text):
+            first, last = starts.get(match.start()), ends.get(match.end())
+            if first is not None and last is not None and last > first + 1:
+                groups[first] = last
+        return groups
+
