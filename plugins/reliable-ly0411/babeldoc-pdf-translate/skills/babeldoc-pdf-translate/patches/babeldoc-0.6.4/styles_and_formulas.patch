+    @staticmethod
+    def source_curve_signature(page):
+        """Every original vector curve keeps exactly one owner while parsing."""
+        curves = list(page.pdf_curve)
+        for paragraph in page.pdf_paragraph:
+            for composition in paragraph.pdf_paragraph_composition:
+                if composition.pdf_formula:
+                    curves.extend(composition.pdf_formula.pdf_curve)
+        return sorted(id(curve) for curve in curves)
