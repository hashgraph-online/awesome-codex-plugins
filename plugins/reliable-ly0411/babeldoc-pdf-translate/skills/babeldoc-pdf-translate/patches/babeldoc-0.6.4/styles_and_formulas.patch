+    @staticmethod
+    def bind_math_accents(page):
+        """Bind each unambiguous raised accent to its geometric math base.
+
+        PDF paint order can put several macrons on a separate, earlier line.
+        Moving the ORIGINAL glyph into its base formula keeps both coordinates
+        and their association; line-id equality cannot establish that relation.
+        """
+        accents = set('¯ˉ‾ˆ˜˙¨')
+        for paragraph in page.pdf_paragraph:
+            compositions = paragraph.pdf_paragraph_composition
+            objects = [(c, c.pdf_formula or c.pdf_line) for c in compositions if c.pdf_formula or c.pdf_line]
+            formulas = [c.pdf_formula for c in compositions if c.pdf_formula]
+            moves = []
+            for composition, obj in objects:
+                for accent in list(obj.pdf_character):
+                    if accent.char_unicode not in accents:
+                        continue
+                    a = accent.visual_bbox.box if accent.visual_bbox else accent.box
+                    candidates = []
+                    for formula in formulas:
+                        for base in formula.pdf_character:
+                            if not base.char_unicode or not base.char_unicode.isalpha() or base.char_unicode in accents:
+                                continue
+                            if base.xobj_id != accent.xobj_id:
+                                continue
+                            b = base.visual_bbox.box if base.visual_bbox else base.box
+                            size = base.pdf_style.font_size
+                            gap = a.y - b.y2
+                            overlap = min(a.x2, b.x2) - max(a.x, b.x)
+                            if (-size * .04 <= gap <= size * .4
+                                    and a.y2 - a.y < size * .35
+                                    and a.x2 - a.x <= (b.x2 - b.x) * 1.8
+                                    and overlap >= min(a.x2 - a.x, b.x2 - b.x) * .6
+                                    and abs((a.x + a.x2 - b.x - b.x2) / 2) <= size * .35):
+                                candidates.append((formula, base))
+                    if len(candidates) != 1:
+                        continue
+                    formula, base = candidates[0]
+                    if formula is not obj:
+                        moves.append((obj, accent, formula, base))
+            for origin, accent, target, base in moves:
+                origin.pdf_character = [c for c in origin.pdf_character if c is not accent]
+                target.pdf_character.insert(target.pdf_character.index(base), accent)
+            for composition, obj in objects:
+                if obj.pdf_character and any(c.char_unicode and not c.char_unicode.isspace() for c in obj.pdf_character):
+                    if composition.pdf_formula:
+                        update_formula_data(obj)
+                    continue
+                # A dummy space between separately painted accents must not
+                # become a 100pt anonymous object in translated prose.
+                if not composition.pdf_formula or not obj.pdf_curve:
+                    compositions.remove(composition)
