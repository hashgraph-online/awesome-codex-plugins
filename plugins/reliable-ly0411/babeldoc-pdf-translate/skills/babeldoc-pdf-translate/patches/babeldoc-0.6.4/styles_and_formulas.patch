+    @staticmethod
+    def source_glyph_signature(page):
+        """Unique visible source glyphs; dummy spacing is not document content."""
+        result = set()
+        for paragraph in page.pdf_paragraph:
+            for composition in paragraph.pdf_paragraph_composition:
+                obj = composition.pdf_formula or composition.pdf_line or composition.pdf_same_style_characters
+                if not obj:
+                    continue
+                for char in obj.pdf_character:
+                    if not char.char_unicode or char.char_unicode.isspace():
+                        continue
+                    box = char.box
+                    result.add((char.xobj_id, char.render_order, char.pdf_character_id,
+                                char.char_unicode, char.pdf_style.font_id,
+                                box.x, box.y, box.x2, box.y2))
+        return result
