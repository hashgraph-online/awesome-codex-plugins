{
  "input": "document.pdf",
  "output": "output/dsh-001",
  "source_language": "en",
  "target_language": "zh-CN",
  "outputs": "both",
  "watermark": "no_watermark",
  "translate_tables": true,
  "auto_terms": true,
  "save_terms": true,
  "timeout_seconds": 7200,
  "provider": {
    "type": "dsh",
    "timeout_seconds": 180,
    "retries": 1,
    "cache_dir": ".translation-cache/dsh",
    "dsh_package": "/path/to/deepseek-harness/apps/cli/package.json",
    "node_bin": "node",
    "model": "deepseek-flash",
    "route": "deepseek-account"
  }
}
